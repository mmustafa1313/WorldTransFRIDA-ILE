						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.5"/>
						<item uid="CLD_Policy_4.16"/>
						<item uid="CLD_Policy_4.29"/>
						<entity name="Ozone_Lifetime"/>
						<entity name="Climate_Impacts"/>
						<item uid="CLD_Policy_4.13"/>
						<entity name="Vegetation_Growth"/>
						<item uid="CLD_Policy_4.9"/>
						<entity name="Emissions"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.32"/>
						<item uid="CLD_Policy_4.6"/>
						<item uid="CLD_Policy_4.7"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.12"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Climate_Impacts"/>
						<item uid="CLD_Policy_4.13"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.5"/>
						<item uid="CLD_Policy_4.3"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Emissions"/>
						<entity name="Atmospheric_CO₂"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, radiative forcing rises, leading to higher surface temperatures and stronger climate impacts. Increased impacts reduce emissions by disrupting economic and energy systems. Lower emissions slow the accumulation of atmospheric CO₂. This creates a balancing feedback loop linking carbon levels, climate impacts, and emission responses.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 9" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<item uid="CLD_Policy_4.21"/>
						<item uid="CLD_Policy_4.26"/>
						<item uid="CLD_Policy_4.2"/>
						<item uid="CLD_Policy_4.10"/>
						<item uid="CLD_Policy_4.20"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.14"/>
						<item uid="CLD_Policy_4.8"/>
						<item uid="CLD_Policy_4.27"/>
						<item uid="CLD_Policy_4.17"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.24"/>
						<item uid="CLD_Policy_4.4"/>
						<item uid="CLD_Policy_4.33"/>
						<item uid="CLD_Policy_4.3"/>
						<item uid="CLD_Policy_4.22"/>
						<item uid="CLD_Policy_4.23"/>
						<entity name="Methane_Lifetime"/>
						<item uid="CLD_Policy_4.30"/>
						<item uid="CLD_Policy_4.5"/>
