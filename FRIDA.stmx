						<item uid="CLD_Policy_4.7"/>
						<item uid="CLD_Policy_4.5"/>
						<entity name="Surface_Temperature"/>
						<entity name="Sea_Level_Rise"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When surface temperature increases, sea level rise accelerates due to melting ice and thermal expansion. Rising sea levels increase climate impacts, particularly in coastal regions. These impacts reduce emissions by disrupting economic activity and infrastructure. Lower emissions reduce radiative forcing, slowing further temperature increase. This creates a balancing feedback loop linked to sea level rise.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 8" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<entity name="Sea_Level_Rise"/>
						<item uid="CLD_Policy_4.25"/>
						<entity name="Methane_Lifetime"/>
						<item uid="CLD_Policy_4.10"/>
						<item uid="CLD_Policy_4.2"/>
						<item uid="CLD_Policy_4.21"/>
						<entity name="Radiative_Forcing"/>
						<item uid="CLD_Policy_4.24"/>
						<item uid="CLD_Policy_4.26"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.28"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.20"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.17"/>
						<item uid="CLD_Policy_4.27"/>
						<item uid="CLD_Policy_4.8"/>
