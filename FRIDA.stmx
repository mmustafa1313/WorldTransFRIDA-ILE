					<isee:animation_location_transforms>
						<isee:animation_location_transform selector="#path4, #path3, #path2, #path1, #path5" x_variable="Interface.Inequality_Bulls_Eye_X_Axis" y_variable="Interface.Inequality_Bulls_Eye_Y_Axis"/>
