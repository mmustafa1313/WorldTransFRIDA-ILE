						<action isee:reset_after="never" isee:reset_value="0" isee:controller_value="1" isee:entity="Interface.Set_Income_Tax_Tick">control_entity</action>
					</actions>
				</button>
				<text_box z_index="56" font_style="italic" vertical_text_align="center" font_color="white" font_size="11pt" appearance="transparent" x="170" y="334.47" width="266.087" height="39.0619" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Set_Income_Tax_Tick">Reduces income tax by 10% (from ~21% to ~11%) over 25 years starting in 2030.</text_box>
				<text_box z_index="56" font_style="italic" vertical_text_align="center" font_color="white" font_size="11pt" appearance="transparent" x="170" y="391.469" width="278.261" height="39.0619" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Set_Profit_Tax_Tick">Raises profit tax from ~32% to ~42% over 25 years starting in 2030.</text_box>
				<button z_index="76" background="#C5DDE9" font_weight="bold" font_color="#082A5C" font_size="10pt" border_color="#F5FFE0" transparent="false" corner_radius="10" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#90A4AE" label="Set Profit Tax" isee:tooltip="" x="10" y="386" width="150" height="50" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."3rd_Policy_Idea_Set_Income_Tax_Button_Appear"'>
					<actions>
						<action isee:reset_after="never" isee:reset_value="0" isee:controller_value="1" isee:entity="Government_Regulations.switch_profit_tax_policy">control_entity</action>
