					</actions>
				</button>
				<text_box z_index="16" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Speed of Policy Implementation &amp; Economic Feedback</text_box>
			</view>
			<view isee:template_view="template:3" isee:name="CLD 4 - Intro" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:shape z_index="16" background="#2D4A74" border_width="thin" border_style="none" transparent_background="false" x="3.3913" y="561.821" width="74.7826" height="35" block_mouse="true" kind="rectangle"/>
				<text_box font_weight="bold" text_align="center" font_color="#2A6FB8" font_size="48pt" appearance="transparent" x="138" y="94.9091" width="790" height="59">S E E    T H E    S Y S T E M</text_box>
				<text_box font_style="italic" text_align="center" vertical_text_align="center" font_color="#2E3A46" font_size="16pt" appearance="transparent" x="10.2726" y="153.909" width="1045.45" height="151.545">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic;&quot;&gt;The climate system is shaped by interconnected physical processes.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic;&quot;&gt;Carbon flows between the atmosphere, land, and oceans while temperature alters ecosystems and atmospheric chemistry.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic;&quot;&gt;These interactions create feedback that can either stabilize or amplify climate change.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic;&quot;&gt;Some feedback absorb carbon and slow change, while others weaken this capacity and accelerate warming.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_style="italic" text_align="center" vertical_text_align="center" font_color="#2E3A46" font_size="16pt" appearance="transparent" x="125.7" y="365" width="814.6" height="169.091">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Hover over arrows to explore causal relationships.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Hover over loop labels to understand each feedback cycle.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic;&quot;&gt;Each page introduces a new feedback loop. Together, they reveal how the climate system evolves over time.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;The first loop of this pathway appears next.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_weight="bold" text_align="center" font_color="#2A6FB8" font_size="28pt" appearance="transparent" x="285.273" y="327.455" width="495.454" height="48.9091">HOW   TO   EXPLORE</text_box>
				<isee:shape border_color="#2A6FB8" border_width="0.4" opacity="0.49" x="335.091" y="293.636" width="395.818" height="24.5455" kind="hline"/>
				<text_box z_index="-6" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Earth System Climate Feedback Dynamics</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 1" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.32"/>
						<item uid="CLD_Policy_4.16"/>
						<item uid="CLD_Policy_4.22"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.33"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.16"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Atmospheric_CO₂"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, land carbon uptake rises as plants absorb more carbon through photosynthesis. Increased carbon uptake reduces atmospheric CO₂ levels. Lower atmospheric CO₂ weakens radiative forcing and slows temperature increase. This creates a balancing feedback loop where terrestrial ecosystems help stabilize the climate system.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 2" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<item uid="CLD_Policy_4.32"/>
						<item uid="CLD_Policy_4.16"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.14"/>
						<item uid="CLD_Policy_4.22"/>
						<item uid="CLD_Policy_4.23"/>
						<item uid="CLD_Policy_4.33"/>
						<item uid="CLD_Policy_4.15"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.17"/>
						<entity name="Atmospheric_CO₂"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.15"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.17"/>
						<entity name="Ocean_Carbon_Uptake"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, more CO₂ dissolves into ocean water, increasing ocean carbon uptake. This reduces atmospheric CO₂ and weakens radiative forcing. As radiative forcing declines, temperature increase slows. This creates a balancing feedback loop driven by ocean carbon absorption.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 3" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
						<entity name="Radiative_Forcing"/>
						<item uid="CLD_Policy_4.24"/>
						<item uid="CLD_Policy_4.32"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.16"/>
						<item uid="CLD_Policy_4.15"/>
						<item uid="CLD_Policy_4.33"/>
						<item uid="CLD_Policy_4.9"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.17"/>
						<item uid="CLD_Policy_4.8"/>
						<item uid="CLD_Policy_4.22"/>
						<item uid="CLD_Policy_4.23"/>
						<entity name="Methane_Lifetime"/>
					</isee:visible_list>
					<isee:highlight_list>
						<entity name="Methane_Lifetime"/>
						<item uid="CLD_Policy_4.9"/>
						<item uid="CLD_Policy_4.8"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Surface_Temperature"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When methane lifetime increases, methane remains longer in the atmosphere, increasing radiative forcing and surface temperature. Higher temperatures accelerate atmospheric chemical reactions that reduce methane lifetime. This shortens methane persistence in the atmosphere and limits further increases in radiative forcing. This creates a balancing feedback loop regulating methane’s contribution to warming.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 4" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.24"/>
						<entity name="Radiative_Forcing"/>
						<item uid="CLD_Policy_4.32"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.10"/>
						<item uid="CLD_Policy_4.17"/>
						<item uid="CLD_Policy_4.8"/>
						<item uid="CLD_Policy_4.16"/>
						<entity name="Ozone_Lifetime"/>
						<item uid="CLD_Policy_4.25"/>
						<item uid="CLD_Policy_4.9"/>
						<item uid="CLD_Policy_4.15"/>
						<item uid="CLD_Policy_4.33"/>
						<item uid="CLD_Policy_4.23"/>
						<item uid="CLD_Policy_4.22"/>
						<entity name="Methane_Lifetime"/>
						<entity name="Surface_Temperature"/>
					</isee:visible_list>
					<isee:highlight_list>
						<entity name="Surface_Temperature"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Sea_Level_Rise"/>
						<entity name="Ozone_Lifetime"/>
						<entity name="Climate_Impacts"/>
						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.2"/>
						<item uid="CLD_Policy_4.10"/>
						<item uid="CLD_Policy_4.7"/>
						<item uid="CLD_Policy_4.3"/>
						<item uid="CLD_Policy_4.4"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When ozone lifetime increases, ozone remains in the atmosphere longer, increasing radiative forcing and surface temperature. Higher temperatures accelerate processes that break down ozone, reducing its lifetime. This limits ozone’s contribution to radiative forcing and temperature increase. This creates a balancing feedback loop regulating ozone’s role in the climate system.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 5" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<item uid="CLD_Policy_4.24"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Methane_Lifetime"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.10"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.21"/>
						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.32"/>
						<item uid="CLD_Policy_4.20"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.28"/>
						<item uid="CLD_Policy_4.16"/>
						<item uid="CLD_Policy_4.23"/>
						<item uid="CLD_Policy_4.22"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.17"/>
						<item uid="CLD_Policy_4.8"/>
						<item uid="CLD_Policy_4.9"/>
						<entity name="Vegetation_Growth"/>
						<entity name="Ozone_Lifetime"/>
						<item uid="CLD_Policy_4.25"/>
						<item uid="CLD_Policy_4.15"/>
						<item uid="CLD_Policy_4.33"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.3"/>
						<item uid="CLD_Policy_4.7"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.21"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.14"/>
						<item uid="CLD_Policy_4.4"/>
						<entity name="Vegetation_Growth"/>
						<entity name="Climate_Impacts"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Sea_Level_Rise"/>
						<item uid="CLD_Policy_4.20"/>
						<entity name="Surface_Temperature"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, radiative forcing and surface temperature rise. Higher temperatures and CO₂ levels can stimulate vegetation growth under favorable conditions. Increased vegetation growth enhances land carbon uptake, reducing atmospheric CO₂. This creates a balancing feedback loop where ecosystem growth helps offset climate change.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 6" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:visible_list>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.2"/>
						<item uid="CLD_Policy_4.10"/>
						<entity name="Ocean_Carbon_Uptake"/>
						<entity name="Methane_Lifetime"/>
