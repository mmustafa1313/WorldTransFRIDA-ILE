						<entity name="Investment"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.37"/>
						<item uid="CLD_Policy_1.9"/>
						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.18"/>
						<entity name="Investment_Growth_Relative_to_Overall_Economic_Growth"/>
						<item uid="CLD_Policy_1.15"/>
						<item uid="CLD_Policy_1.35"/>
					</isee:visible_list>
					<isee:highlight_list>
						<entity name="Inflation"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.17"/>
						<entity name="Investment"/>
						<entity name="Investment_Growth_Relative_to_Overall_Economic_Growth"/>
						<item uid="CLD_Policy_1.15"/>
						<item uid="CLD_Policy_1.18"/>
						<item uid="CLD_Policy_1.16"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="206.667">When the economy grows quickly, investment rises at an accelerated pace. If investment grows faster than the rest of the economy, inflation begins to increase. Higher inflation reduces purchasing power and slows economic activity. This natural slowdown brings growth back toward a more stable level, balancing the system.</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 7" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
