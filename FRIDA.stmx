			<view isee:template_view="template:3" isee:name="CLD 1- Intro" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:shape z_index="16" background="#2D4A74" border_width="thin" border_style="none" transparent_background="false" x="3.3913" y="561.821" width="74.7826" height="35" block_mouse="true" kind="rectangle"/>
				<text_box font_weight="bold" text_align="center" font_color="#2A6FB8" font_size="48pt" appearance="transparent" x="138" y="94.9091" width="790" height="59">S E E    T H E    S Y S T E M</text_box>
				<text_box font_style="italic" text_align="center" vertical_text_align="center" font_color="#2E3A46" font_size="16pt" appearance="transparent" x="183.909" y="162.909" width="698.182" height="101.818">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Beneath policies and headlines lies a connected feedback structure.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-weight:700; font-style:italic; color:#000000;&quot;&gt;Growth, employment, finance, and climate&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt; continuously influence one another.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;You are about to explore how the full system unfolds.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_style="italic" text_align="center" vertical_text_align="center" font_color="#2E3A46" font_size="16pt" appearance="transparent" x="183.909" y="374.091" width="698.182" height="160">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Hover over arrows to explore causal relationships.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Hover over loop labels to understand each feedback cycle.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;Each page adds another loop. The system builds.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:12pt; font-style:italic; color:#000000;&quot;&gt;The first loop of this pathway appears next.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box font_weight="bold" text_align="center" font_color="#2A6FB8" font_size="28pt" appearance="transparent" x="285.273" y="327.455" width="495.454" height="48.9091">HOW   TO   EXPLORE</text_box>
				<isee:shape border_color="#2A6FB8" border_width="0.4" opacity="0.49" x="335.091" y="279.091" width="395.818" height="24.5455" kind="hline"/>
				<text_box z_index="-6" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Carbon Tax &amp; Energy Transition Dynamics</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 1" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.15"/>
						<item uid="CLD_Policy_1.46"/>
						<item uid="CLD_Policy_1.45"/>
						<item uid="CLD_Policy_1.14"/>
						<entity name="Investment"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.36"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_1.15"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.14"/>
						<entity name="Investment"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="27" background="#FAF4F0" font_size="16pt" padding="20" border_color="#999999" border_width="0.1" appearance="transparent" x="150" y="120" width="325" height="280.556">When investment increases, companies build new facilities, adopt new technologies, and expand production. These improvements create economic growth. A stronger economy encourages even more investment. This creates a reinforcing cycle that strengthens economic growth.</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 2" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.15"/>
						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.46"/>
						<item uid="CLD_Policy_1.38"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.14"/>
						<entity name="Investment"/>
						<item uid="CLD_Policy_1.32"/>
						<item uid="CLD_Policy_1.45"/>
						<entity name="Employment"/>
						<item uid="CLD_Policy_1.10"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_1.10"/>
						<item uid="CLD_Policy_1.32"/>
						<item uid="CLD_Policy_1.15"/>
						<entity name="Economic_Output"/>
						<entity name="Employment"/>
						<entity name="Investment"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="27" background="#FAF4F0" font_size="16pt" padding="20" border_color="#999999" border_width="0.1" appearance="transparent" x="150" y="120" width="325" height="263.384">A growing economy increases business confidence and profitability. Higher economic growth encourages firms to invest more. Increased investment expands production capacity and creates new jobs, raising employment. As more people earn stable incomes, household spending rises, boosting overall demand in the economy. Stronger demand further stimulates economic growth, reinforcing the cycle.</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 3" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.7"/>
						<item uid="CLD_Policy_1.15"/>
						<item uid="CLD_Policy_1.35"/>
						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.38"/>
						<item uid="CLD_Policy_1.46"/>
						<entity name="Employment"/>
						<entity name="Government_Revenue"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.14"/>
						<entity name="Investment"/>
						<item uid="CLD_Policy_1.32"/>
						<item uid="CLD_Policy_1.45"/>
						<item uid="CLD_Policy_1.11"/>
						<item uid="CLD_Policy_1.10"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_1.11"/>
						<entity name="Economic_Output"/>
						<entity name="Government_Revenue"/>
						<item uid="CLD_Policy_1.7"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="256.667">When the economy grows, people earn more and businesses generate more activity. This increases the amount of tax collected by the government. With more revenue available, the government can invest in services, infrastructure, and stability, which spurs additional economic growth. The cycle continues to reinforce itself as long as growth continues.</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 4" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="275">When economic growth increases, businesses expand and investment rises. Higher investment creates more jobs, raising employment. As more people earn income and firms generate higher profits, tax revenues increase. With stronger government revenue, the state can fund public investment and services. This increases economic output, reinforcing the cycle between growth, employment, and government finances.</text_box>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.7"/>
						<entity name="Employment"/>
						<item uid="CLD_Policy_1.10"/>
						<item uid="CLD_Policy_1.40"/>
						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.46"/>
						<item uid="CLD_Policy_1.38"/>
						<entity name="Economic_Output"/>
						<entity name="Government_Revenue"/>
						<item uid="CLD_Policy_1.45"/>
						<item uid="CLD_Policy_1.32"/>
						<entity name="Investment"/>
						<item uid="CLD_Policy_1.14"/>
						<item uid="CLD_Policy_1.11"/>
						<item uid="CLD_Policy_1.9"/>
						<item uid="CLD_Policy_1.35"/>
						<item uid="CLD_Policy_1.15"/>
					</isee:visible_list>
					<isee:highlight_list>
						<entity name="Economic_Output"/>
						<entity name="Government_Revenue"/>
						<item uid="CLD_Policy_1.32"/>
						<item uid="CLD_Policy_1.7"/>
						<item uid="CLD_Policy_1.9"/>
						<item uid="CLD_Policy_1.15"/>
						<entity name="Investment"/>
						<entity name="Employment"/>
					</isee:highlight_list>
				</isee:model_view>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 5" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.7"/>
						<item uid="CLD_Policy_1.11"/>
						<entity name="Investment_Growth_Relative_to_Overall_Economic_Growth"/>
						<item uid="CLD_Policy_1.38"/>
						<entity name="Economic_Output"/>
						<entity name="Government_Revenue"/>
						<item uid="CLD_Policy_1.46"/>
						<item uid="CLD_Policy_1.34"/>
						<entity name="Inflation"/>
						<entity name="Employment"/>
						<item uid="CLD_Policy_1.16"/>
						<item uid="CLD_Policy_1.41"/>
						<item uid="CLD_Policy_1.45"/>
						<item uid="CLD_Policy_1.32"/>
						<item uid="CLD_Policy_1.14"/>
						<entity name="Investment"/>
						<item uid="CLD_Policy_1.10"/>
						<item uid="CLD_Policy_1.40"/>
						<item uid="CLD_Policy_1.9"/>
						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.18"/>
						<item uid="CLD_Policy_1.35"/>
						<item uid="CLD_Policy_1.15"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_1.18"/>
						<entity name="Investment_Growth_Relative_to_Overall_Economic_Growth"/>
						<entity name="Inflation"/>
						<item uid="CLD_Policy_1.34"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.16"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="248.889">When the growth in investment is higher then the growth of the economy there are fewer opportunities to make productive investments. Too much investment relative to overall output raises production costs and creates inflationary pressure. Higher inflation weakens economic activity even more. This reinforces the downward trend in growth and makes recovery harder.</text_box>
			</view>
			<view isee:template_view="template:4" isee:name="CLD 1-Structure 6" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:model_view z_index="30" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.38"/>
						<item uid="CLD_Policy_1.7"/>
