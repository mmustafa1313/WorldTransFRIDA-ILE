					</actions>
				</button>
				<text_box z_index="22" font_weight="bold" text_align="center" font_size="14pt" appearance="transparent" x="687.273" y="84.6364" width="167.273" height="17.9086">Causal Structure</text_box>
				<isee:navigation_widget z_index="19" border_width="thin" border_style="none" item_spacing="3" appearance="tabs" corner_radius="5" selected_item_background="#FAF4F0" item_background="#DDD9D5" orientation="horizontal" x="77.5" y="54.6" width="340" height="25">
