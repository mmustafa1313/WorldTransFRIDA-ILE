				<isee:animation_object z_index="33" x="378.5" y="374.5" width="484" height="102.75" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.BullsEye_Inequality_Visibility" isee:immediately_update_on_user_input="true" isee:use_active_value="true">
