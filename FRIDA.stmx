				<text_box z_index="14" background="#E8EBF1" vertical_text_align="center" font_color="#082A5C" padding="8" x="355" y="289.77" width="355" height="48" isee:locked="true">The GDP per person will reach $48500 annually.</text_box>
				<text_box z_index="14" background="#E8EBF1" vertical_text_align="center" font_color="#082A5C" padding="8" x="710" y="289.77" width="356" height="48" isee:locked="true">51.26 % of the GDP is expected to be allocated to labor.</text_box>
				<text_box background="#F5F6FA" font_weight="bold" text_align="center" vertical_text_align="center" font_color="#082A5C" font_size="16pt" border_color="#989898" border_width="0.1" x="0" y="258" width="1066" height="32" isee:locked="true">Median Outcomes in 2100</text_box>
