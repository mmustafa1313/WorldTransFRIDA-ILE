				<graphics_frame z_index="69" fill="none" x="1026" y="112.5" width="30" height="30" isee:locked="true">
					<image width="117" height="125" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Button 1.png</image>
				</graphics_frame>
				<graphics_frame z_index="68" fill="none" x="1026" y="185" width="30" height="30" isee:locked="true">
					<image width="117" height="125" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Button 2.png</image>
				</graphics_frame>
				<text_box z_index="74" font_color="#082A5C" font_size="14pt" padding="8" border_width="thin" border_style="solid" corner_radius="10" x="550" y="94" width="450" height="67" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."2nd_Policy_Idea_Button_1"'>To address inequality, we adjust the tax structure by gradually lowering income taxes and increasing profit taxes beginning in 2030.</text_box>
				<text_box z_index="73" font_color="#082A5C" font_size="14pt" padding="8" border_width="thin" border_style="solid" corner_radius="10" x="550" y="169.295" width="450" height="67.41" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."2nd_Policy_Idea_Button_2"'>These changes are phased in over 25 years to maintain economic stability, consistent with the gradual approach used for carbon taxes and energy subsidies.</text_box>
				<text_box z_index="73" font_color="#082A5C" font_size="14pt" padding="8" border_width="thin" border_style="solid" corner_radius="10" x="550" y="244" width="450" height="57" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."2nd_Policy_Idea_Button_3"'>Select each taxation policy button to apply these adjustments. When both are set, click the next page button &gt;</text_box>
				<graphics_frame z_index="62" fill="none" x="475" y="339" width="30" height="30" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Set_Income_Tax_Tick">
					<image width="128" height="128" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/checkbox.png</image>
