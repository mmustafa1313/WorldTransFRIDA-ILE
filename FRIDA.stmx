				</isee:navigation_widget>
				<isee:shape z_index="48" background="#2D4A74" border_width="thin" border_style="none" transparent_background="false" x="2.81818" y="561.019" width="39.0909" height="36" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Return_to_Dashboard_Button_from_Navigation_for_Guide" block_mouse="true" kind="rectangle"/>
				<isee:shape z_index="49" background="#2D4A74" border_width="thin" border_style="none" transparent_background="false" x="1022.46" y="561.019" width="39.0909" height="36" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Return_to_Dashboard_Button_from_Navigation_for_Guide" block_mouse="true" kind="rectangle"/>
				<button z_index="47" background="#FBF5F0" font_weight="bold" font_size="8pt" border_color="#F5FFE0" transparent="false" corner_radius="15" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#D3F0FF" label="Return to Dashboard" isee:tooltip="" x="473" y="565" width="120" height="30" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.Return_to_Dashboard_Button_from_Navigation_for_Guide">
