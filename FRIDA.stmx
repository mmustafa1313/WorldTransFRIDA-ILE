			<view isee:template_view="template:2" isee:name="Intro Page" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<text_box z_index="-2" background="white" font_size="14pt" padding="20" border_width="0.5" corner_radius="13" x="18.045" y="90.8531" width="1029.91" height="455.219" isee:locked="true">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;Welcome to the FRIDA climate action simulator.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;This is an interactive tool where we can learn more about the relationship between human activities and climate. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;We will explore questions such as:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;      What will happen to the climate if human activities continue as they have in the past? &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;      Which changes in human behavior will enable us to reach climate goals? &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;      What are the implications of climate-friendly human activities for well-being and the economy?&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;The simulation results can be analyzed in various target areas to make decisions that impact key aspects of society and the environment.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;You&apos;ll explore how reducing GHG emissions can make the world a better place for everyone. You&apos;ll be focusing on three key areas that define our future:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;1. Surface Temperature Anomaly (STA) – This tells us how much the Earth’s temperature is changing over time.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;2. GDP per Person – This shows the economic health of countries and it&apos;s impacts on people&apos;s lives.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;3. Labour Share of GDP – This examines one portion of the wealth disparity and how it might be reduced.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;Click on this icons below to access the Navigation Guide and the Terminology Guide, or &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#55aa00;&quot;&gt;use the Next Page button &amp;gt;&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt; to continue to the next section of the ILE.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<text_box z_index="5" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="20pt" appearance="transparent" x="283" y="0" width="500" height="50">FRIDA GLOBAL CLIMATE SIMULATOR
</text_box>
				<text_box z_index="-4" text_align="center" vertical_text_align="center" font_color="white" font_size="14pt" appearance="transparent" x="283" y="30" width="500" height="50">Exploring the Co-Evolution of Climate and Humanity</text_box>
				<button z_index="13" transparent="true" corner_radius="12" label="" isee:tooltip="" x="12.4665" y="566.546" width="26.1554" height="24.9464">
					<actions>
						<action target="interface:0">navigate</action>
					</actions>
				</button>
				<button z_index="15" transparent="true" corner_radius="12" label="" isee:tooltip="" x="1032.59" y="566.058" width="18.838" height="25.9222">
					<actions>
						<action>start</action>
						<action isee:run_name_to_set="EMB">set_run_name</action>
						<action target="interface:8">navigate</action>
					</actions>
				</button>
				<button z_index="17" background="#F5FFE0" transparent="true" corner_radius="10" isee:highlight_on_hover="true" isee:highlight_color="#607D8B" label="" isee:tooltip="Terminology Guide" x="603" y="464.182" width="60" height="60">
					<actions>
						<action target="interface:3">navigate</action>
					</actions>
					<image width="512" height="512" size_to_parent="true">r../Graphics/reading-glasses.png</image>
				</button>
				<button z_index="17" background="#90A4AE" border_color="white" border_width="4" border_style="none" transparent="true" corner_radius="10" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#607D8B" label="" isee:tooltip="Navigation Guide" x="403" y="464.182" width="60" height="60">
					<actions>
						<action target="interface:2">navigate</action>
					</actions>
					<image width="512" height="512" size_to_parent="true">r../Graphics/questions.png</image>
				</button>
			</view>
			<view isee:template_view="template:2" isee:name="Navigation &amp; Terminology Guide" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<text_box z_index="5" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Navigation &amp; Terminology Guide</text_box>
				<button z_index="13" transparent="true" corner_radius="12" label="" isee:tooltip="" x="12.4665" y="566.546" width="21.087" height="24.9464">
					<actions>
						<action target="interface:1">navigate</action>
					</actions>
				</button>
				<isee:shape background="white" border_width="0.5" border_style="none" transparent_background="false" corner_radius="15" x="20" y="94" width="1026" height="456" isee:locked="true" kind="rectangle"/>
				<graphics_frame fill="none" x="50" y="180" width="40" height="40" isee:locked="true">
					<image width="256" height="256" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Home icon.png</image>
				</graphics_frame>
				<graphics_frame fill="none" x="50" y="260" width="40" height="40" isee:locked="true">
					<image width="128" height="128" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Guided Demonstration Charcoal.png</image>
				</graphics_frame>
				<graphics_frame fill="none" x="50" y="340" width="40" height="40" isee:locked="true">
					<image width="128" height="128" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Goal Setting Charcoal.png</image>
				</graphics_frame>
				<graphics_frame fill="none" x="50" y="420" width="40" height="40" isee:locked="true">
					<image width="128" height="128" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/Dashboard Charcoal.png</image>
				</graphics_frame>
				<text_box vertical_text_align="center" font_size="14pt" appearance="transparent" x="115" y="172" width="550" height="56" isee:locked="true">The Home section is your starting point in this ILE. Here, you will get an overview of what’s to come in the simulation.</text_box>
				<text_box vertical_text_align="center" font_size="14pt" appearance="transparent" x="115" y="242.5" width="550" height="75" isee:locked="true">In the Guided Demonstration, you’ll explore how to use the ILE tool, understand its features, and see how different variables interact within the system. Follow the steps to get familiar with the tool before making your own decisions.</text_box>
				<text_box vertical_text_align="center" font_size="14pt" appearance="transparent" x="115" y="330" width="550" height="60" isee:locked="true">In the Goal Settings section, review how key variables have developed over time. Set your targets and target year for these variables, to establish a reference point for your analysis in the dashboard section.</text_box>
				<text_box vertical_text_align="center" font_size="14pt" appearance="transparent" x="115" y="402.5" width="550" height="75" isee:locked="true">In the Dashboard section, you get to interact with the model in real-time. Use this section to adjust key variables, explore different scenarios, and visualize the results of your choices. The Dashboard provides all the tools you need to test your decisions and see how your actions affect the system.</text_box>
				<isee:shape z_index="15" border_color="#989898" border_width="0.5" opacity="1" transparent_background="false" x="683.15" y="95" width="14" height="454" isee:locked="true" kind="vline"/>
				<text_box vertical_text_align="center" font_size="16pt" appearance="transparent" x="714" y="338.5" width="306" height="109" isee:locked="true">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#00aa00;&quot;&gt;Click the above icon&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt; to open the Terminology Guide and learn the meaning of key terms and graphs used in this ILE &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#00aa00;&quot;&gt;Click the Next Page button &amp;gt;&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:10pt; color:#000000;&quot;&gt; to proceed to the next section of the ILE.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<button z_index="15" transparent="true" corner_radius="12" isee:native_tooltip="false" isee:highlight_on_hover="true" isee:highlight_color="#607D8B" label="" isee:tooltip="Terminology Guide" x="807" y="190" width="120" height="120" isee:locked="true">
