						<item uid="CLD_Policy_1.36"/>
						<item uid="CLD_Policy_1.18"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_1.12"/>
						<entity name="Economic_Output"/>
						<item uid="CLD_Policy_1.2"/>
						<entity name="Surface_Temperature_Anomaly"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="248.333">Higher economic output leads to greater energy use and more emissions. As emissions rise, global temperature increases. A hotter climate disrupts economic activity through physical damages, lower productivity, and higher costs. These climate impacts slow the economy, creating a balancing relationship between economic growth and climate stress.</text_box>
			</view>
			<view isee:template_view="template:5" isee:name="CLD 1 - Policy Effect 1" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="32" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
