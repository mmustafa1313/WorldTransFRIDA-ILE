				<isee:shape z_index="-11" background="#29446B" border_color="white" border_width="0.1" opacity="0.3" transparent_background="false" corner_radius="15" x="-12" y="90" width="540" height="200" isee:locked="true" kind="rectangle"/>
				<graphics_frame fill="none" x="950" y="205" width="68" height="35" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.processing_Icon_3">
