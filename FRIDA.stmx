			<view isee:template_view="template:14" isee:name="4. 1st Policy Idea" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<isee:annotation z_index="16" background="#90A4AE" font_weight="bold" font_color="#082A5C" border_color="white" border_width="2.5" border_style="none" corner_radius="15" isee:highlight_on_hover="true" isee:highlight_color="#455A64" popup_corner_radius="10" popup_background_color="white" highlight_on_open="true" popup_font_color="#082A5C" popup_font_size="14pt" popup_text__padding="2" launcher_label="1" show_by_default="true" hide_launcher="false" launch_on_hover="false" x="1041" y="132.5" isee:locked="true">
					<popup x="545.957" y="100.368" width="464.103" height="80.7185">
						<text>Energy production is a major source of greenhouse gas emissions, and carbon taxes are commonly proposed to encourage a transition toward cleaner energy.</text>
					</popup>
				</isee:annotation>
				<isee:annotation z_index="15" background="#90A4AE" font_weight="bold" font_color="#082A5C" border_color="white" border_width="2.5" border_style="none" corner_radius="15" isee:highlight_on_hover="true" isee:highlight_color="#455A64" popup_corner_radius="10" popup_background_color="white" highlight_on_open="true" popup_font_color="#082A5C" popup_font_size="14pt" popup_text__padding="2" launcher_label="2" show_by_default="false" hide_launcher="false" launch_on_hover="false" x="1041" y="190" isee:locked="true">
					<popup hide_when_editing="true" x="545.654" y="153.326" width="462.968" height="79.174">
						<text>By changing the relative cost of high-carbon and low-carbon energy sources, carbon taxes can shift the energy mix, reduce warming, and support more stable long-term economic conditions.</text>
					</popup>
				</isee:annotation>
				<isee:annotation z_index="15" background="#90A4AE" font_weight="bold" font_color="#082A5C" border_color="white" border_width="2.5" border_style="none" corner_radius="15" isee:highlight_on_hover="true" isee:highlight_color="#455A64" popup_corner_radius="10" popup_background_color="white" highlight_on_open="true" popup_font_color="#082A5C" popup_font_size="14pt" popup_text__padding="2" launcher_label="3" show_by_default="false" hide_launcher="false" launch_on_hover="false" x="1041" y="247.5" isee:locked="true">
					<popup hide_when_editing="true" x="547.118" y="182.69" width="461.78" height="96.2228">
						<text>The next step is to test this policy in the model. You will implement a carbon tax and observe how the system responds.

Click the next page button &gt;</text>
					</popup>
