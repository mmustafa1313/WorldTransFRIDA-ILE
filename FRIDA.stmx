				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="270">Investment increases employment by creating new jobs and expanding economic activity. Bankruptcies, on the other hand, reduce employment as firms close or scale down operations. These two forces influence employment in opposite directions. When the energy transition creates stranded assets, rising bankruptcies creates more firing decreasing employment</text_box>
			</view>
			<view isee:template_view="template:5" isee:name="CLD 1 - Policy Effect 7" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
