			<view isee:template_view="template:2" isee:name="Terminology Guide 2" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<text_box z_index="5" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Navigation &amp; Terminology Guide</text_box>
				<button z_index="13" transparent="true" corner_radius="12" label="" isee:tooltip="" x="12.4665" y="566.546" width="26.1554" height="24.9464">
					<actions>
						<action target="previous_page">navigate</action>
					</actions>
				</button>
				<button z_index="15" transparent="true" corner_radius="12" label="" isee:tooltip="" x="1032.59" y="566.058" width="18.838" height="25.9222">
					<actions>
						<action target="next_page">navigate</action>
