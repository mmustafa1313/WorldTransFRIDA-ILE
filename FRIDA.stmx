						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.4"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Sea_Level_Rise"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When surface temperature increases, climate impacts intensify, including extreme weather and disruptions to infrastructure and economic activity. These impacts can reduce production and energy use, leading to lower emissions. Reduced emissions decrease radiative forcing, slowing further temperature increase. This creates a balancing feedback loop where climate impacts influence emissions.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 7" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
