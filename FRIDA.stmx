						<entity name="Atmospheric_CO₂"/>
						<entity name="Emissions"/>
						<entity name="Radiative_Forcing"/>
						<entity name="Sea_Level_Rise"/>
						<item uid="CLD_Policy_4.6"/>
						<item uid="CLD_Policy_4.7"/>
						<item uid="CLD_Policy_4.32"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.28"/>
						<item uid="CLD_Policy_4.25"/>
						<entity name="Ozone_Lifetime"/>
						<entity name="Climate_Impacts"/>
						<entity name="Vegetation_Growth"/>
						<item uid="CLD_Policy_4.13"/>
						<item uid="CLD_Policy_4.9"/>
						<item uid="CLD_Policy_4.15"/>
					</isee:visible_list>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.12"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.5"/>
						<item uid="CLD_Policy_4.13"/>
						<entity name="Climate_Impacts"/>
						<entity name="Emissions"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.2"/>
						<item uid="CLD_Policy_4.7"/>
						<entity name="Sea_Level_Rise"/>
						<entity name="Radiative_Forcing"/>
						<item uid="CLD_Policy_4.4"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, radiative forcing rises, leading to higher surface temperatures and increased sea level rise. Rising sea levels intensify climate impacts, which can reduce emissions through disruptions to economic systems. Lower emissions slow the accumulation of atmospheric CO₂. This creates a balancing feedback loop connecting carbon dynamics, sea level rise, and emission responses.</text_box>
			</view>
			<view isee:template_view="template:10" isee:name="CLD 4 - Loop 10" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.18"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Land_Carbon_Uptake"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.13"/>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.19"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Vegetation_Damage"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="298.224">When atmospheric CO₂ increases, radiative forcing rises, leading to higher surface temperatures. As temperatures increase, vegetation damage intensifies due to heat stress and extreme climate conditions. Increased vegetation damage reduces land carbon uptake, allowing more CO₂ to remain in the atmosphere. This further increases radiative forcing and temperature. This creates a reinforcing feedback loop where ecosystem degradation amplifies climate change.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 1" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.12"/>
						<entity name="Surface_Temperature"/>
						<item uid="CLD_Policy_4.13"/>
						<entity name="Emissions"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">When emissions increase, more greenhouse gases are released into the atmosphere, especially carbon dioxide from energy use and land processes. This raises atmospheric CO₂ concentrations over time as the system accumulates more carbon than it removes. Higher CO₂ levels strengthen radiative forcing by trapping more outgoing heat within the Earth’s system. As a result, surface temperature increases.

When emissions decrease, the rate at which CO₂ accumulates slows. This reduces the growth of radiative forcing and helps slow the increase in surface temperature.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 2" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.12"/>
						<item uid="CLD_Policy_4.2"/>
						<entity name="Atmospheric_CO₂"/>
						<entity name="Surface_Temperature"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">Atmospheric CO₂ plays a central role in controlling the Earth’s energy balance. When CO₂ concentrations increase, more heat is trapped in the atmosphere due to the greenhouse effect. This strengthens radiative forcing and leads to a rise in surface temperature.

When atmospheric CO₂ decreases, less heat is retained in the system. This weakens radiative forcing and reduces the pressure driving temperature increase.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 3" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.16"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Land_Carbon_Uptake"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">The land system acts as a natural carbon sink through vegetation and soils. When atmospheric CO₂ increases, plants can absorb more carbon through photosynthesis under suitable conditions. This increases land carbon uptake, removing CO₂ from the atmosphere and partially offsetting emissions.

However, when atmospheric CO₂ decreases, this fertilization effect weakens. As a result, land carbon uptake declines, reducing the system’s ability to regulate atmospheric CO₂</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 4" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.15"/>
						<entity name="Atmospheric_CO₂"/>
						<item uid="CLD_Policy_4.17"/>
						<entity name="Ocean_Carbon_Uptake"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">The oceans absorb a significant portion of atmospheric CO₂ through physical and chemical processes. When atmospheric CO₂ increases, more CO₂ dissolves into ocean water, increasing ocean carbon uptake. This helps reduce atmospheric CO₂ and slows the rate of climate change.

When atmospheric CO₂ decreases, less CO₂ is available to dissolve into the oceans. This reduces ocean carbon uptake and weakens its stabilizing role in the climate system.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 5" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<entity name="Methane_Lifetime"/>
						<item uid="CLD_Policy_4.11"/>
						<item uid="CLD_Policy_4.9"/>
						<entity name="Ozone_Lifetime"/>
						<item uid="CLD_Policy_4.10"/>
						<item uid="CLD_Policy_4.8"/>
						<entity name="Surface_Temperature"/>
						<entity name="Radiative_Forcing"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">Surface temperature influences atmospheric chemistry. When temperature increases, chemical reactions in the atmosphere accelerate, leading to faster breakdown of gases like methane and ozone. This reduces their atmospheric lifetimes and lowers their contribution to radiative forcing.

When temperature decreases, these chemical reactions slow down. Methane and ozone remain in the atmosphere longer, increasing their contribution to radiative forcing and warming.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 6" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.20"/>
						<entity name="Surface_Temperature"/>
						<entity name="Vegetation_Growth"/>
						<item uid="CLD_Policy_4.21"/>
						<entity name="Land_Carbon_Uptake"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">Temperature affects plant growth through changes in growing seasons and biological activity. When surface temperature increases moderately, growing conditions can improve in some regions, leading to increased vegetation growth. This higher growth increases biomass production and enhances land carbon uptake.

When temperature decreases or becomes less favorable, vegetation growth slows. This reduces carbon uptake and weakens the land system’s ability to remove CO₂ from the atmosphere.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 7" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.18"/>
						<entity name="Atmospheric_CO₂"/>
						<entity name="Land_Carbon_Uptake"/>
						<item uid="CLD_Policy_4.19"/>
						<item uid="CLD_Policy_4.14"/>
						<entity name="Vegetation_Damage"/>
						<entity name="Surface_Temperature"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">As surface temperature rises beyond optimal levels, ecosystems begin to experience stress. Heatwaves, droughts, and extreme weather events increase vegetation damage, reducing plant health and biomass. This lowers land carbon uptake, meaning less CO₂ is removed from the atmosphere.

As a result, atmospheric CO₂ accumulates more rapidly. This strengthens radiative forcing and further increases surface temperature, reinforcing climate change through ecosystem degradation.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 8" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<item uid="CLD_Policy_4.7"/>
						<item uid="CLD_Policy_4.4"/>
						<entity name="Surface_Temperature"/>
						<entity name="Sea_Level_Rise"/>
						<entity name="Climate_Impacts"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">When surface temperature increases, it drives both thermal expansion of seawater and melting of glaciers and ice sheets. These processes contribute to rising sea levels over time. Higher sea levels increase the risk of flooding, coastal erosion, and damage to infrastructure and settlements.

These changes increase the overall level of climate impacts experienced by human and natural systems.</text_box>
			</view>
			<view isee:template_view="template:11" isee:name="CLD 4 - Policy Effect 9" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list>
						<entity name="Climate_Impacts"/>
						<entity name="Emissions"/>
						<item uid="CLD_Policy_4.5"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="400.042">Climate impacts feed back into human activity. When climate impacts increase, they disrupt infrastructure, reduce productivity, and damage economic systems. These disruptions can reduce energy use and industrial activity, leading to lower emissions.

When climate impacts are lower, economic activity can expand more easily. This increases energy use and emissions, strengthening the link between human systems and the climate.</text_box>
			</view>
			<view isee:template_view="template:3" isee:name="CLD 4 - END" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<text_box z_index="16" font_size="14pt" padding="10" appearance="transparent" x="35" y="105.218" width="425" height="402.149">The Complete System

You have now explored how emissions, atmospheric CO₂, radiative forcing, surface temperature, vegetation dynamics, carbon uptake, and climate impacts interact through reinforcing and balancing feedback loops.

Some processes, such as carbon uptake by land and oceans, stabilize the system by removing CO₂. At the same time, rising temperatures can damage ecosystems and reduce this capacity, amplifying climate change.

Here is the entire causal loop diagram. It brings together atmospheric processes, ecosystem responses, and climate impacts into one connected system, showing how feedback within the Earth system shape climate change over time.</text_box>
				<isee:shape z_index="30" background="#2C4973" border_width="thin" border_style="none" transparent_background="false" x="1018.53" y="561.019" width="46.9565" height="36" block_mouse="true" kind="rectangle"/>
				<text_box z_index="22" font_weight="bold" text_align="center" font_size="14pt" appearance="transparent" x="687.273" y="84.6364" width="167.273" height="17.9086">Causal Structure</text_box>
				<isee:navigation_widget z_index="19" border_width="thin" border_style="none" item_spacing="3" appearance="tabs" corner_radius="5" selected_item_background="#FAF4F0" item_background="#DDD9D5" orientation="horizontal" x="77.5" y="54.6" width="350.909" height="25">
					<isee:navigation_item label="Understanding the System" target="interface:110"/>
					<isee:navigation_item label="Understanding the Policy Effects" target="interface:113"/>
				</isee:navigation_widget>
				<text_box z_index="16" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Earth System Climate Feedback Dynamics</text_box>
				<isee:model_view z_index="16" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" show_animations="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_4"/>
					<isee:highlight_list/>
				</isee:model_view>
				<button z_index="16" background="#FBF5F0" font_weight="bold" font_color="#082A5C" font_size="8pt" border_color="#F5FFE0" border_width="thin" border_style="none" transparent="false" corner_radius="15" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#D3F0FF" label="Return to Pathway Menu" isee:tooltip="" x="473" y="565" width="120" height="30" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."Regular_-_Causal_Structure_Skip_to_End_Button"'>
