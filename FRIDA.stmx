			<view isee:template_view="template:2" isee:name="Terminology Guide 4" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<text_box z_index="-3" background="white" text_align="center" vertical_text_align="center" font_color="white" font_size="18pt" appearance="transparent" x="283" y="0" width="500" height="50" isee:locked="true">Navigation &amp; Terminology Guide</text_box>
				<button z_index="13" transparent="true" corner_radius="12" label="" isee:tooltip="" x="9.9323" y="566.546" width="25" height="25">
					<actions>
						<action target="previous_page">navigate</action>
					</actions>
				</button>
				<isee:shape background="white" border_width="0.5" border_style="none" transparent_background="false" corner_radius="15" x="20" y="94" width="1026" height="456" isee:locked="true" kind="rectangle"/>
				<text_box vertical_text_align="center" font_size="14pt" appearance="transparent" x="90" y="180" width="540" height="327">Gross Domestic Product (GDP) is an economic measure that represents the total value of all goods and services produced within a country over a specific period. It reflects the overall size, activity, and health of an economy. GDP is used to track economic growth, compare countries, and evaluate how policies or external events influence economic performance.

It typically includes:

Consumption: Household spending on goods and services, such as food, housing, transportation, and entertainment.

Investment: Business spending on equipment, buildings, and technology, as well as household spending on new housing.

Government Spending: Public expenditures on services like education, healthcare, and infrastructure.

Net Exports: The value of a country’s exports minus its imports. Positive net exports add to GDP; negative net exports reduce it.
</text_box>
				<isee:shape z_index="15" border_color="#989898" border_width="0.5" opacity="1" transparent_background="false" x="683.15" y="95" width="14" height="454" kind="vline"/>
				<text_box text_align="center" vertical_text_align="center" font_size="20pt" appearance="transparent" x="20" y="101.5" width="668" height="58">Gross Domestic Product (GDP)</text_box>
				<graphics_frame fill="none" x="779.293" y="235.478" width="185.217" height="173.043">
					<image width="512" height="512" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/gdp.png</image>
				</graphics_frame>
				<button z_index="15" transparent="true" corner_radius="12" label="" isee:tooltip="" x="1032.59" y="566.058" width="18.838" height="25.9222">
					<actions>
						<action target="next_page">navigate</action>
					</actions>
				</button>
				<isee:navigation_widget border_width="thin" border_style="none" item_spacing="1" orientation="horizontal" x="50.4136" y="64" width="884.545" height="30">
					<isee:navigation_item label="Endogenous Model Behavior" target="interface:3"/>
