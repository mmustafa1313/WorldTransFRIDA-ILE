						<item uid="CLD_Policy_1.19"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="263.889">A carbon tax encourages cleaner forms of energy by making fossil fuels more expensive. This pushes the energy system to transition faster. As cleaner energy replaces fossil fuels, emissions fall and the rise in surface temperature slows. A Carbon tax does not change the feedback structure of the model itself, but it pushes on this key point where human policy influences physical climate outcomes.</text_box>
			</view>
			<view isee:template_view="template:5" isee:name="CLD 1 - Policy Effect 2" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="32" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
					<model name="CLD_Policy_1"/>
					<isee:visible_list>
						<item uid="CLD_Policy_1.2"/>
