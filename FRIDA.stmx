			<view isee:template_view="template:18" isee:name="1.1.1 Dashboard STA Confidence" background="#082A5C" page_width="1066" page_height="600" zoom="180" type="interface">
				<style/>
				<stacked_container x="20" y="100" width="955" height="450" isee:locked="true" z_index="28">
					<graph axis_color="white" grid_color="#90A4AE" isee:graph_area_color="white" isee:transparent="true" isee:hide_border="true" axis_title_font_size="10pt" axis_label_font_size="10pt" width="955" height="450" isee:locked="true" comparative="true" type="confidence" show_grid="true" isee:tick_type="none" include_units_in_legend="false" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="14" num_y_grid_lines="0" num_x_labels="14" num_y_labels="5" title=" Surface Temperature Anomaly (°C)" isee:fill_intensity="0.3" to="2150" from="2020" isee:allow_zero_axis="true" left_axis_title="°C" left_axis_multi_scale="false" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="false" right_axis_auto_scale="true" right_include_units="true">
						<plot color="#3A35FF" isee:keep_zero_visible="false" pen_width="1" index="0" show_y_axis="true">
							<format precision="0.01" scale_by="1"/>
							<entity name="Energy_Balance_Model.Surface_Temperature_Anomaly[*]"/>
