					</actions>
				</button>
				<button z_index="16" background="#FBF5F0" font_weight="bold" font_color="#082A5C" font_size="8pt" border_color="#F5FFE0" border_width="thin" border_style="none" transparent="false" corner_radius="15" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#D3F0FF" label="Explore More Pathways" isee:tooltip="" x="548" y="565" width="120" height="30" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."Causal_Link_-_Return_to_Dashboard_Button"'>
					<actions>
						<action isee:reset_after="never" isee:reset_value="0" isee:controller_value="0" isee:entity='Interface."Causal_Link_-_Return_to_Dashboard_Button"'>control_entity</action>
