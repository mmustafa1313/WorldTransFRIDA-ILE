					<image width="128" height="128" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Graphics/checkbox.png</image>
				</graphics_frame>
				<isee:shape z_index="45" background="#082A5C" border_width="thin" border_style="none" transparent_background="false" x="313.563" y="355.807" width="455.396" height="203.212" isee:locked="true" kind="rectangle"/>
				<button z_index="75" background="#C5DDE9" font_weight="bold" font_color="#082A5C" font_size="10pt" border_color="#F5FFE0" transparent="false" corner_radius="10" isee:flat="false" isee:highlight_on_hover="true" isee:highlight_color="#90A4AE" label="Lower Income Tax" isee:tooltip="" x="10" y="329" width="150" height="50" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity='Interface."3rd_Policy_Idea_Set_Income_Tax_Button_Appear"'>
					<actions>
						<action isee:reset_after="never" isee:reset_value="0" isee:controller_value="1" isee:entity="Government_Regulations.switch_wage_tax_policy">control_entity</action>
						<action>control_entity</action>
