				<button z_index="90" transparent="true" isee:native_tooltip="false" icon_side="top" label="" isee:tooltip="More Options" x="1013.12" y="313.512" width="20" height="20" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Government_Regulations.switch_wealth_tax_policy">
