				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="245">When bankruptcies threaten the stability of the financial system, governments may intervene with bank bailouts. These bailouts help banks recover losses and resume lending. When banks start lending again, investment increases. This restores some of the economic activity that was disrupted by the stranded assets created during the energy transition.</text_box>
			</view>
			<view isee:template_view="template:5" isee:name="CLD 1 - Policy Effect 6" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="32" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_animations="true" show_ltm_table="false" include_documentation="true">
