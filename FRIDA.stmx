						<item uid="CLD_Policy_1.7"/>
					</isee:highlight_list>
				</isee:model_view>
				<text_box z_index="16" font_size="16pt" padding="20" appearance="transparent" x="150" y="120" width="325" height="292.222">A carbon tax creates a new revenue stream for the government. When the tax is applied to fossil fuels, the government collects more income that can be used for public investment, infrastructure, and climate initiatives. Higher government revenue means higher government spending, and increased economic growth.</text_box>
			</view>
			<view isee:template_view="template:5" isee:name="CLD 1 - Policy Effect 3" background="#082A5C" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<isee:model_view z_index="32" x="485" y="80" width="570" height="470" isee:locked="true" zoom="0.5" center_x="576" center_y="480" locked_view="true" use_visible_list="true" show_ltm_table="false" include_documentation="true">
