				<isee:animation_object z_index="36" x="378.5" y="88" width="484" height="101.5" isee:locked="true" isee:conditional_immediately_update_on_user_input="true" isee:conditional_use_active_value="true" isee:conditional_entity="Interface.BullsEye_STA_Visibility" isee:immediately_update_on_user_input="true" isee:use_active_value="true">
