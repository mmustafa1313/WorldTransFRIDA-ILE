				<isee:annotation z_index="99" transparent="true" launcher_label="" show_by_default="false" hide_launcher="false" launch_on_hover="true" x="110.352" y="421">
					<popup hide_when_editing="true" x="404.429" y="391.238" width="195.571" height="59.5237">
