				<connect2 to="Climate_Risk_Perception.switch_behavioral_impact" from="Climate.switch_behavioral_impact"/>
				<connect to="Climate_Risk_Perception.switch_environmental_consciousness_policy" from="Behavioral_Choices.switch_environmental_consciousness_policy"/>
				<connect2 to="Climate_Risk_Perception.switch_environmental_consciousness_policy" from="Behavioral_Choices.switch_environmental_consciousness_policy"/>
				<connect to="Climate_Risk_Perception.switch_sea_level_rise_climate_risk_perception" from="Climate.switch_sea_level_rise_climate_risk_perception"/>
				<connect2 to="Climate_Risk_Perception.switch_sea_level_rise_climate_risk_perception" from="Climate.switch_sea_level_rise_climate_risk_perception"/>
				<connect to="Climate_Risk_Perception.today" from="Climate.climate_impact_stoptime"/>
				<connect2 to="Climate_Risk_Perception.today" from="Climate.climate_impact_stoptime"/>
			</module>
			<module name="Animal Products\nDemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Food_Demand.average_yearly_demand_per_capita" from="Animal_Products_Demand.average_yearly_demand_per_capita"/>
				<connect2 to="Food_Demand.average_yearly_demand_per_capita" from="Animal_Products_Demand.average_yearly_demand_per_capita"/>
				<connect to="Animal_Products_Demand.additional_environmental_consciousness_policy" from="Behavioral_Choices.additional_environmental_consciousness_policy"/>
