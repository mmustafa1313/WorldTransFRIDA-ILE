				</element>
				<range min="20" max="100"/>
				<units>year</units>
			</aux>
			<aux name="indicated short term\ntrend">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Yearly_Consumption-Reference_Short_Term_Consumption)/Reference_Short_Term_Consumption/time_horizon_for_short_term_perception</eqn>
				<units>dmnl/year</units>
			</aux>
			<aux name="desired demand\nfrom descriptive norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Yearly_Demand*(1+ indicated_short_term_trend*expectation_time_horizon)</eqn>
				<units>MtN/year</units>
			</aux>
			<aux name="time to adjust desired\ndemand from accessibility">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.00009864254961</eqn>
				</element>
