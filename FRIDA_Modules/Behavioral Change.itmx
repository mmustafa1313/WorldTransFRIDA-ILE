			</aux>
			<aux name="normal perceived\nclimate change risk">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="maximum effect of additional\nenvironmental consciousness\non reference time horizon">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>5</eqn>
				<range min="2.5" max="7.5"/>
				<units>dmnl</units>
			</aux>
			<aux name="normal additional\ntime horizon of reference\ntemperature anomaly">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>10.0090359609919</eqn>
				</element>
				<element subscript="2">
					<eqn>10.0585901431554</eqn>
				</element>
				<element subscript="3">
					<eqn>10.0423875187253</eqn>
				</element>
				<element subscript="4">
