				</element>
				<range min="1" max="5"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nShort Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Yearly_Consumption</eqn>
				<inflow>updating_short_term_reference_consumption</inflow>
				<units>MtN/year</units>
			</stock>
			<flow name="updating short term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Yearly_Consumption-Reference_Short_Term_Consumption)/time_horizon_for_short_term_perception</eqn>
				<units>MtN/year/Year</units>
			</flow>
			<aux name="time horizon for\nshort term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
