			<aux name="Population 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="crop balance 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="animal products production 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="effect of climate\nrisk on personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_climate_risk^(sensitivity_of_personal_norm_to_climate_risk*APD_climate_attribution_policy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of consumption\nrisk on personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_consumption_risk^(sensitivity_of_personal_norm_to_consumption_risk*APD_consumption_risk_policy_on_sensitivity_of_personal_norms)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of social value\non personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Social_Value^sensitivity_of_personal_norm_to_social_value</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived climate risk" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Perceived\nSocial Value">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>indicated_social_value</eqn>
				<inflow>change_in_value_perception</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="change in value perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_social_value-Perceived_Social_Value)/time_to_adjust_value_perception</eqn>
				<units>dmnl/year</units>
			</flow>
			<aux name="indicated social value">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>normal_perceived_social_value*effect_of_relative_long_term_consumption_on_social_value_perception*APD_cultural_revaluation_policy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="time to adjust\nvalue perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>5.42392369672329</eqn>
				</element>
				<element subscript="2">
					<eqn>5.57954434297868</eqn>
				</element>
				<element subscript="3">
					<eqn>3.57817346412108</eqn>
				</element>
				<element subscript="4">
					<eqn>5.54766402284574</eqn>
				</element>
				<element subscript="5">
					<eqn>6.25386467225951</eqn>
				</element>
				<element subscript="6">
					<eqn>4.35816717260267</eqn>
				</element>
				<element subscript="7">
					<eqn>4.92193755080258</eqn>
				</element>
				<element subscript="8">
					<eqn>5.33610243748916</eqn>
				</element>
				<element subscript="9">
					<eqn>3.84488112884508</eqn>
				</element>
				<element subscript="10">
					<eqn>4.76466273699312</eqn>
				</element>
				<element subscript="11">
					<eqn>3.52420893300657</eqn>
				</element>
				<range min="3" max="50"/>
				<units>years</units>
			</aux>
			<aux name="UNIT c$ per billion c$" access="output" isee:autocreated="true">
				<doc>${Unit}
</doc>
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="sensitivity of demand\nto relative scarcity">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.572862204991351</eqn>
				</element>
				<element subscript="2">
					<eqn>0.587988894766896</eqn>
				</element>
				<element subscript="3">
					<eqn>0.559452971832186</eqn>
				</element>
				<element subscript="4">
					<eqn>0.553109638409748</eqn>
				</element>
				<element subscript="5">
					<eqn>0.638504994503395</eqn>
				</element>
				<element subscript="6">
					<eqn>0.637962162021052</eqn>
				</element>
				<element subscript="7">
					<eqn>0.646202685891814</eqn>
				</element>
				<element subscript="8">
					<eqn>0.652642240456607</eqn>
				</element>
				<element subscript="9">
					<eqn>0.520759364152616</eqn>
				</element>
				<element subscript="10">
					<eqn>0.650071502011796</eqn>
				</element>
				<element subscript="11">
					<eqn>0.547804767127446</eqn>
				</element>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of\nrelative scarcity\non demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>scarcity_of_products_compared_to_alternative^sensitivity_of_demand_to_relative_scarcity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal perceived\nsocial value">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="producer waste fraction">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(animal_products_production_1-total_yearly_consumption)/animal_products_production_1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="indicated\naverage desired demand per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Desired_Demand_from_Accessibility,  
(weight_of_personal_norm*desired_demand_from_personal_norm + desired_demand_from_descriptive_norm*weight_of_descriptive_norm + weight_of_accessibility*Desired_Demand_from_Accessibility))</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="indicated demand\nfrom accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Average_Daily_Demand_Per_Capita_1*share_of_demand_from_consumption_domain</eqn>
				<units>kcal/person/day</units>
			</aux>
			<stock name="Desired Demand\nfrom Accessibility">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Average_Daily_Demand_Per_Capita_1*initial_share_of_demand_from_consumption_domain</eqn>
				<inflow>change_in_desired_demand_from_accessibility</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="change in desired\ndemand from accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_demand_from_accessibility-Desired_Demand_from_Accessibility)/time_to_adjust_desired_demand_from_accessibility</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="initial share of demand\nfrom consumption domain">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.182060175557098</eqn>
				</element>
				<element subscript="2">
					<eqn>0.182585633551338</eqn>
				</element>
				<element subscript="3">
					<eqn>0.183029887518325</eqn>
				</element>
				<element subscript="4">
					<eqn>0.182102695691717</eqn>
				</element>
				<element subscript="5">
					<eqn>0.182937699837347</eqn>
				</element>
				<element subscript="6">
					<eqn>0.182519774492022</eqn>
				</element>
				<element subscript="7">
					<eqn>0.182983820467235</eqn>
				</element>
				<element subscript="8">
					<eqn>0.183167327852653</eqn>
				</element>
				<element subscript="9">
					<eqn>0.181902385995039</eqn>
				</element>
				<element subscript="10">
					<eqn>0.182989103336783</eqn>
				</element>
				<element subscript="11">
					<eqn>0.182660751027062</eqn>
				</element>
				<range min="0.15" max="0.3"/>
				<units>dmnl</units>
			</aux>
			<aux name="share of demand\nfrom consumption domain">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(1,  initial_share_of_demand_from_consumption_domain*effect_of_GDP_per_capita_on_demand*effect_of_relative_scarcity_on_demand)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\naccessibility">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>reference_weight_of_accessibility*socioeconomic_effect_on_weight_of_accessibility</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\npersonal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*relative_weight_of_personal_norm</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\ndescriptive norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*(1-relative_weight_of_personal_norm)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative weight\nof personal norm">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="total yearly demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_yearly_demand_per_capita*Population_1</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="average daily\ndemand per capita">
				<doc>${Calibrated Output,Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Desired_Average_Daily_Demand_Per_Capita, Desired_Demand_from_Accessibility)</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="Average Daily\nDemand Per Capita 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>kCal/Person/Day</units>
			</aux>
			<aux name="effect of GDP per capita\non demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(real_GDP_per_person/INIT(real_GDP_per_person))^elasticity_of_demand_to_GDP</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="elasticity of demand\nto GDP">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.19850862077893</eqn>
				</element>
				<element subscript="2">
					<eqn>0.206634692934443</eqn>
				</element>
				<element subscript="3">
					<eqn>0.205331505120433</eqn>
				</element>
				<element subscript="4">
					<eqn>0.209364150577253</eqn>
				</element>
				<element subscript="5">
					<eqn>0.209872148800336</eqn>
				</element>
				<element subscript="6">
					<eqn>0.201762506574267</eqn>
				</element>
				<element subscript="7">
					<eqn>0.208940676268649</eqn>
				</element>
				<element subscript="8">
					<eqn>0.202835485434687</eqn>
				</element>
				<element subscript="9">
