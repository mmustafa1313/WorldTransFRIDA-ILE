				<connect2 to="Animal_Products_Demand.real_GDP_per_person_1" from="Demographics.real_GDP_per_person"/>
				<connect to="Animal_Products_Demand.start_year" from="Climate_Risk_Perception.start_year"/>
				<connect2 to="Animal_Products_Demand.start_year" from="Climate_Risk_Perception.start_year"/>
				<connect to="Animal_Products_Demand.switch_environmental_consciousness_policy" from="Behavioral_Choices.switch_environmental_consciousness_policy"/>
				<connect2 to="Animal_Products_Demand.switch_environmental_consciousness_policy" from="Behavioral_Choices.switch_environmental_consciousness_policy"/>
