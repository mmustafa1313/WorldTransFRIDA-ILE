	<model name="Climate_Risk_Perception">
		<variables>
			<aux name="Surface Temperature Anomaly" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>deg C</units>
			</aux>
			<aux name="Perceived Temperature Anomaly">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_behavioral_impact =0) AND TIME &gt; today THEN
PREVIOUS(SELF, Surface_Temperature_Anomaly)
ELSE
SMTH3(Surface_Temperature_Anomaly, time_to_report_and_perceive_climate_information, Surface_Temperature_Anomaly)</eqn>
				<isee:delay_aux/>
				<units>deg C</units>
			</aux>
			<aux name="time to report and perceive\nclimate information">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>9.05767380759289</eqn>
				</element>
				<element subscript="2">
					<eqn>8.3600882448985</eqn>
				</element>
				<element subscript="3">
					<eqn>7.94998569276787</eqn>
				</element>
				<element subscript="4">
					<eqn>8.77853989183093</eqn>
				</element>
				<element subscript="5">
					<eqn>7.51788888343547</eqn>
				</element>
				<element subscript="6">
					<eqn>7.60547130328429</eqn>
				</element>
				<element subscript="7">
					<eqn>9.58779978972265</eqn>
				</element>
				<element subscript="8">
					<eqn>9.7998709514671</eqn>
				</element>
				<element subscript="9">
					<eqn>9.82822048978667</eqn>
				</element>
				<element subscript="10">
					<eqn>7.62412176878684</eqn>
				</element>
				<element subscript="11">
					<eqn>9.03960487108152</eqn>
				</element>
				<range min="1" max="10"/>
				<units>years</units>
			</aux>
			<stock name="Reference Temperature\nAnomaly">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Temperature_Anomaly</eqn>
				<inflow>updating_reference_temperature_anomaly</inflow>
				<units>deg C</units>
			</stock>
			<flow name="updating reference temperature anomaly">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Temperature_Anomaly-Reference_Temperature_Anomaly)/time_horizon_of_reference_temperature_anomaly</eqn>
				<units>deg C/Year</units>
			</flow>
			<aux name="additional time horizon of reference\ntemperature anomaly">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;start_year AND switch_environmental_consciousness_policy THEN
normal_additional_time_horizon_of_reference_temperature_anomaly*(1 + maximum_effect_of_additional_environmental_consciousness_on_reference_time_horizon*additional_environmental_consciousness_policy)
ELSE
normal_additional_time_horizon_of_reference_temperature_anomaly</eqn>
				<units>year</units>
			</aux>
			<stock name="Perceived Climate\nExtremes Exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Climate_indices_with_record_breaking_exposure_per_person_per_year</eqn>
				<inflow>updating_climate_extremes_perception</inflow>
				<units>Indices/person/year</units>
			</stock>
			<flow name="updating climate extremes perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF (switch_behavioral_impact =0) AND TIME &gt; today THEN
PREVIOUS(SELF, 0)
ELSE
(Climate_indices_with_record_breaking_exposure_per_person_per_year-Perceived_Climate_Extremes_Exposure)/time_to_perceive_climate_extremes_exposure</eqn>
				<units>Indices/person/year/Year</units>
			</flow>
			<stock name="Reference Climate\nExtremes Exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Climate_Extremes_Exposure</eqn>
				<inflow>updating_reference_climate_extremes_exposure</inflow>
				<units>Indices/person/year</units>
			</stock>
			<flow name="updating reference\nclimate extremes exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Climate_Extremes_Exposure-Reference_Climate_Extremes_Exposure)/time_horizon_of_reference_climate_extremes_exposure</eqn>
				<units>Indices/person/year/Year</units>
			</flow>
			<aux name="additional time horizon of reference\nclimate extremes exposure">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>41.6090602258884</eqn>
				</element>
				<element subscript="2">
					<eqn>78.5563158993961</eqn>
				</element>
