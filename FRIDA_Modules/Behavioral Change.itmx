				</element>
				<element subscript="11">
					<eqn>1.44910688647354</eqn>
				</element>
				<range min="1" max="30"/>
				<units>years</units>
			</aux>
			<aux name="sensitivity of personal norm\nto consumption risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-1.99635685006402</eqn>
				</element>
				<element subscript="2">
					<eqn>-1.9877611636564</eqn>
				</element>
