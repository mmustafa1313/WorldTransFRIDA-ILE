					<eqn>-1.99958116999869</eqn>
				</element>
				<element subscript="11">
					<eqn>-1.99780814930984</eqn>
				</element>
				<range min="-2" max="-0.1"/>
				<units>dmnl</units>
			</aux>
			<aux name="effect of consumption\nrisk on personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_consumption_risk^sensitivity_of_personal_norm_to_consumption_risk</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of social value\non personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAX(0, Perceived_Social_Value)^sensitivity_of_personal_norm_to_social_value</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Perceived\nSocial Value">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>indicated_social_value</eqn>
				<inflow>change_in_value_perception</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="change in value perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_social_value-Perceived_Social_Value)/time_to_adjust_value_perception</eqn>
				<units>dmnl/year</units>
			</flow>
			<aux name="indicated social value">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>normal_perceived_social_value*effect_of_relative_long_term_consumption_on_social_value_perception</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="time to adjust\nvalue perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>3.0004314368825</eqn>
				</element>
				<element subscript="2">
					<eqn>3.00507664956626</eqn>
				</element>
				<element subscript="3">
					<eqn>3.00020603017872</eqn>
				</element>
				<element subscript="4">
					<eqn>3.00307653868672</eqn>
				</element>
				<element subscript="5">
					<eqn>3.00102783189458</eqn>
				</element>
				<element subscript="6">
					<eqn>3.00554921003121</eqn>
				</element>
				<element subscript="7">
					<eqn>3.00438615472768</eqn>
				</element>
				<element subscript="8">
					<eqn>3.00419419314296</eqn>
				</element>
				<element subscript="9">
					<eqn>3.00288509243511</eqn>
				</element>
				<element subscript="10">
					<eqn>3.00127081145753</eqn>
				</element>
				<element subscript="11">
					<eqn>3.00222201331816</eqn>
				</element>
				<range min="3" max="50"/>
				<units>years</units>
			</aux>
			<aux name="UNIT c$ per billion c$">
				<doc>${Unit}
</doc>
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="normal perceived\nsocial value">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="indicated\ndesired yearly\ndemand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN((weight_of_personal_norm*desired_demand_from_personal_norm + desired_demand_from_descriptive_norm*weight_of_descriptive_norm + weight_of_accessibility*Desired_Demand_from_Accessibility), Desired_Demand_from_Accessibility)</eqn>
				<units>MtN/year</units>
			</aux>
			<aux name="indicated demand\nfrom accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fertilizer_demand_in_1980*effect_of_GDP_per_capita_on_demand*effect_of_scarcity_on_demand*effect_of_cost_of_natural_gas_on_demand*effect_of_natural_gas_scarcity_on_accessibility</eqn>
				<units>MtN/year</units>
			</aux>
			<flow name="change in desired\ndemand from accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_demand_from_accessibility-Desired_Demand_from_Accessibility)/time_to_adjust_desired_demand_from_accessibility</eqn>
				<units>MtN/year/Year</units>
			</flow>
			<aux name="weight of\naccessibility">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>reference_weight_of_accessibility*socioeconomic_effect_on_weight_of_accessibility</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\npersonal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*relative_weight_of_personal_norm</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\ndescriptive norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*(1-relative_weight_of_personal_norm)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative weight\nof personal norm">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="total yearly demand" access="output" isee:autocreated="true">
				<doc>${Calibrated Output,Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(Desired_Yearly_Demand, Desired_Demand_from_Accessibility)</eqn>
				<units>MtN/year</units>
			</aux>
			<stock name="Desired Demand\nfrom Accessibility">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fertilizer_demand_in_1980</eqn>
				<inflow>change_in_desired_demand_from_accessibility</inflow>
				<units>MtN/year</units>
			</stock>
			<aux name="initial fertilizer demand\nin 1980">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>89.9999995751841</eqn>
				</element>
				<element subscript="2">
					<eqn>89.9998203414931</eqn>
				</element>
				<element subscript="3">
