	<model name="Animal_Products_Demand">
		<variables>
			<flow name="change in desired demand per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_average_desired_demand_per_capita-Desired_Average_Daily_Demand_Per_Capita)/time_to_adjust_consumption_pattern</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<stock name="Desired Average Daily\nDemand Per Capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita_in_1980</eqn>
				<inflow>change_in_desired_demand_per_capita</inflow>
				<units>kcal/person/day</units>
			</stock>
			<aux name="UNIT cal per pcal">
				<doc>${Unit}
</doc>
				<eqn>1000000000000</eqn>
				<units>KCal/PCal</units>
			</aux>
			<aux name="average yearly\ndemand per capita" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita*UNIT_days_per_year*UNIT_p_per_Mp/UNIT_cal_per_pcal</eqn>
				<units>PCal/Mp/Year</units>
			</aux>
			<aux name="UNIT days per year">
				<doc>${Unit}
</doc>
				<eqn>365</eqn>
				<units>days/year</units>
			</aux>
			<aux name="UNIT p per Mp">
				<doc>${Unit}
</doc>
				<eqn>1000000</eqn>
				<units>person/Mp</units>
			</aux>
			<aux name="time to adjust\nconsumption pattern">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>4.45397691257469</eqn>
				</element>
				<element subscript="2">
					<eqn>4.25706692322156</eqn>
				</element>
				<element subscript="3">
					<eqn>4.56543275112308</eqn>
				</element>
				<element subscript="4">
					<eqn>4.51469151339744</eqn>
				</element>
				<element subscript="5">
					<eqn>4.34463701086203</eqn>
				</element>
				<element subscript="6">
					<eqn>4.59712643269387</eqn>
				</element>
				<element subscript="7">
					<eqn>4.7719490112178</eqn>
				</element>
				<element subscript="8">
					<eqn>4.62031512058962</eqn>
				</element>
				<element subscript="9">
					<eqn>4.76637250712049</eqn>
				</element>
				<element subscript="10">
					<eqn>4.47522702286265</eqn>
				</element>
				<element subscript="11">
					<eqn>4.31076139832418</eqn>
				</element>
				<range min="1" max="10"/>
				<units>years</units>
			</aux>
			<aux name="average daily demand\nper capita in 1980">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>376.373237615953</eqn>
				</element>
				<element subscript="2">
					<eqn>379.464149433432</eqn>
				</element>
				<element subscript="3">
					<eqn>376.844032367706</eqn>
				</element>
				<element subscript="4">
					<eqn>377.374909638589</eqn>
				</element>
				<element subscript="5">
					<eqn>377.521073347164</eqn>
				</element>
				<element subscript="6">
					<eqn>377.92566606395</eqn>
				</element>
				<element subscript="7">
					<eqn>380.182506416787</eqn>
				</element>
				<element subscript="8">
					<eqn>379.236132564535</eqn>
				</element>
				<element subscript="9">
					<eqn>379.082625436955</eqn>
				</element>
				<element subscript="10">
					<eqn>379.773463143029</eqn>
				</element>
				<element subscript="11">
					<eqn>380.217554552946</eqn>
				</element>
				<range min="350" max="400"/>
				<units>kcal/person/day</units>
			</aux>
			<aux name="total yearly\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(total_yearly_demand, animal_products_production_1)</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="average daily\nconsumption per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_consumption/Population_1/UNIT_days_per_year/UNIT_p_per_Mp*UNIT_cal_per_pcal</eqn>
				<units>kcal/person/day</units>
			</aux>
			<stock name="Perceived Average\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_consumption_per_capita</eqn>
				<inflow>updating_perceived_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating perceived\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(average_daily_consumption_per_capita-Perceived_Average_Consumption)/time_to_perceive_average_consumption</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time to perceive\naverage consumption">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.53963021440829</eqn>
				</element>
				<element subscript="2">
					<eqn>1.66752571509856</eqn>
				</element>
				<element subscript="3">
					<eqn>1.48889058122536</eqn>
				</element>
				<element subscript="4">
					<eqn>2.33434960197021</eqn>
				</element>
				<element subscript="5">
					<eqn>4.14867517476233</eqn>
				</element>
				<element subscript="6">
					<eqn>3.84226080883585</eqn>
				</element>
				<element subscript="7">
					<eqn>3.05593601686469</eqn>
				</element>
				<element subscript="8">
					<eqn>3.58093542033454</eqn>
				</element>
				<element subscript="9">
					<eqn>3.52566131030894</eqn>
				</element>
				<element subscript="10">
					<eqn>2.81579477402317</eqn>
				</element>
				<element subscript="11">
					<eqn>1.7891427093913</eqn>
				</element>
				<range min="1" max="5"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nShort Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_short_term_reference_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating short term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/time_horizon_for_short_term_perception</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nshort term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>8.90946371518593</eqn>
				</element>
				<element subscript="2">
					<eqn>2.78915276209438</eqn>
				</element>
				<element subscript="3">
					<eqn>5.6601492771305</eqn>
				</element>
				<element subscript="4">
					<eqn>8.15515597944282</eqn>
				</element>
				<element subscript="5">
					<eqn>8.70873695564549</eqn>
				</element>
				<element subscript="6">
					<eqn>6.07076973049991</eqn>
				</element>
				<element subscript="7">
					<eqn>4.20733569928963</eqn>
				</element>
				<element subscript="8">
					<eqn>6.44574099496943</eqn>
				</element>
				<element subscript="9">
					<eqn>4.63512596608838</eqn>
				</element>
				<element subscript="10">
					<eqn>9.23772726685191</eqn>
				</element>
				<element subscript="11">
					<eqn>2.27624096261628</eqn>
				</element>
				<range min="1" max="20"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nLong Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_long_term_reference_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating long term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Long_Term_Consumption)/time_horizon_for_long_term_perception</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nlong term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>63.6621050245434</eqn>
				</element>
				<element subscript="2">
					<eqn>62.1993345078094</eqn>
				</element>
				<element subscript="3">
					<eqn>59.3117842462759</eqn>
				</element>
				<element subscript="4">
					<eqn>60.554409561403</eqn>
				</element>
				<element subscript="5">
					<eqn>59.1297556138615</eqn>
				</element>
				<element subscript="6">
					<eqn>61.9298767810426</eqn>
				</element>
				<element subscript="7">
					<eqn>54.0555974127107</eqn>
				</element>
				<element subscript="8">
					<eqn>56.7472813434431</eqn>
				</element>
				<element subscript="9">
					<eqn>55.4997499352516</eqn>
				</element>
				<element subscript="10">
					<eqn>55.7197693396004</eqn>
				</element>
				<element subscript="11">
					<eqn>49.9544810026621</eqn>
				</element>
				<range min="20" max="100"/>
				<units>year</units>
			</aux>
			<aux name="indicated short term\ntrend">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/Reference_Short_Term_Consumption/time_horizon_for_short_term_perception</eqn>
				<units>dmnl/year</units>
			</aux>
			<aux name="desired demand\nfrom descriptive norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Average_Daily_Demand_Per_Capita*(1+ indicated_short_term_trend*expectation_time_horizon)</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="supply demand\nbalance">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>animal_products_production_1/total_yearly_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="scarcity of products\ncompared to alternative">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(supply_demand_balance/crop_balance_1)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="time to adjust desired\ndemand from accessibility">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1.0258931993514</eqn>
				<range min="1" max="5"/>
				<units>years</units>
			</aux>
			<aux name="perceived consumption\nrelative to long term average">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption/Reference_Long_Term_Consumption</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="desired demand\nfrom personal norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Average_Daily_Demand_Per_Capita*effect_of_climate_risk_on_personal_norm*effect_of_consumption_risk_on_personal_norm*effect_of_social_value_on_personal_norm</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="sensitivity of personal norm\nto climate risk">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;start_year AND switch_environmental_consciousness_policy  THEN 
normal_sensitivity_of_personal_norm_to_climate_risk*(1 + maximum_effect_of_additional_environmental_consciousness*additional_environmental_consciousness_policy)
ELSE
normal_sensitivity_of_personal_norm_to_climate_risk</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of personal norm\nto social value">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.882663109413404</eqn>
				</element>
				<element subscript="2">
					<eqn>0.88843852336557</eqn>
				</element>
				<element subscript="3">
					<eqn>0.91524884678853</eqn>
				</element>
				<element subscript="4">
					<eqn>0.940359869965725</eqn>
				</element>
				<element subscript="5">
					<eqn>0.919986473804889</eqn>
				</element>
				<element subscript="6">
					<eqn>0.930734547859354</eqn>
				</element>
				<element subscript="7">
					<eqn>0.912597828060964</eqn>
				</element>
				<element subscript="8">
					<eqn>0.892872152188612</eqn>
				</element>
				<element subscript="9">
					<eqn>0.929842415230328</eqn>
				</element>
				<element subscript="10">
					<eqn>0.880420915842369</eqn>
				</element>
				<element subscript="11">
					<eqn>0.929946690472681</eqn>
				</element>
				<range min="0.1" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="expectation\ntime horizon">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="healthy reference\ndaily consumption\nper capita">
				<doc>${External Parameter}
Planetary health diet from EAT Lancet https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(18)31788-4/fulltext#seccestitle80
</doc>
				<eqn>304</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="consumption relative\nto healthy reference">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_consumption_per_capita/healthy_reference_daily_consumption_per_capita</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived\nconsumption risk">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(consumption_relative_to_healthy_reference,  (time_to_observe_consequences), consumption_relative_to_healthy_reference)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="time to observe\nconsequences">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>26.7731193008916</eqn>
				</element>
				<element subscript="2">
					<eqn>24.3864105055441</eqn>
				</element>
				<element subscript="3">
					<eqn>24.4335080777249</eqn>
				</element>
				<element subscript="4">
					<eqn>24.718221691871</eqn>
				</element>
				<element subscript="5">
					<eqn>25.970841305619</eqn>
				</element>
				<element subscript="6">
					<eqn>27.6659375208771</eqn>
				</element>
				<element subscript="7">
					<eqn>26.5800562667948</eqn>
				</element>
				<element subscript="8">
					<eqn>27.9260382584022</eqn>
				</element>
				<element subscript="9">
					<eqn>23.5647012918865</eqn>
				</element>
				<element subscript="10">
					<eqn>26.001792460618</eqn>
				</element>
				<element subscript="11">
					<eqn>27.2279023407122</eqn>
				</element>
				<range min="10" max="30"/>
				<units>years</units>
			</aux>
			<aux name="sensitivity of personal norm\nto consumption risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.754669028192609</eqn>
				</element>
				<element subscript="2">
					<eqn>-0.795628206703901</eqn>
				</element>
