			<isee:placeholder name="behavior change\ncalibration data">
				<eqn>Animal_Products.animal_products_production[1] + Animal_Products_Demand.average_daily_demand_per_capita[1] + Crop.crop_production[1] + Food_Demand.direct_food_demand_per_person_per_day[1] + Food_Demand.crop_demand_for_food[1] + Food_Demand.animal_products_demand[1]</eqn>
			</isee:placeholder>
