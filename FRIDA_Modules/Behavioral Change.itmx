				</element>
				<element subscript="10">
					<eqn>1.00069811778409</eqn>
				</element>
				<element subscript="11">
					<eqn>1.00190280850065</eqn>
				</element>
				<range min="1" max="10"/>
				<units>years</units>
			</aux>
			<aux name="total yearly\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_demand</eqn>
				<units>MtN/year</units>
			</aux>
			<stock name="Perceived Yearly\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_consumption</eqn>
				<inflow>updating_perceived_consumption</inflow>
				<units>MtN/year</units>
			</stock>
			<flow name="updating perceived\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(total_yearly_consumption-Perceived_Yearly_Consumption)/time_to_perceive_yearly_consumption</eqn>
				<units>MtN/year/Year</units>
			</flow>
			<aux name="time to perceive\nyearly consumption">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>4.32139835865691</eqn>
				</element>
