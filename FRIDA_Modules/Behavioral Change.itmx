					<eqn>75.6394272935928</eqn>
				</element>
				<element subscript="7">
					<eqn>27.1170670944689</eqn>
				</element>
				<element subscript="8">
					<eqn>32.4068364052518</eqn>
				</element>
				<element subscript="9">
					<eqn>37.0035459394941</eqn>
				</element>
				<element subscript="10">
					<eqn>23.1542997151747</eqn>
				</element>
				<element subscript="11">
					<eqn>67.5969151135558</eqn>
				</element>
				<range min="10" max="100"/>
				<units>year</units>
			</aux>
			<aux name="time to perceive\nclimate extremes exposure">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>5.3415386116243</eqn>
				</element>
				<element subscript="2">
					<eqn>6.1853205826709</eqn>
				</element>
				<element subscript="3">
					<eqn>4.89941631198254</eqn>
				</element>
				<element subscript="4">
					<eqn>5.18902562826972</eqn>
				</element>
				<element subscript="5">
					<eqn>6.73771813414829</eqn>
				</element>
				<element subscript="6">
					<eqn>5.2169895840825</eqn>
				</element>
				<element subscript="7">
					<eqn>5.33280899411405</eqn>
				</element>
				<element subscript="8">
					<eqn>6.23424534710161</eqn>
				</element>
				<element subscript="9">
					<eqn>7.09157159935492</eqn>
				</element>
				<element subscript="10">
					<eqn>6.83009645426374</eqn>
				</element>
				<element subscript="11">
					<eqn>6.57122317288731</eqn>
				</element>
				<format precision="0.01"/>
				<range min="1" max="10"/>
				<units>year</units>
			</aux>
			<aux name="relative perceived\ntemperature anomaly\ninformation">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Temperature_Anomaly/Reference_Temperature_Anomaly</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative perceived\nclimate extremes exposure">
				<doc>

Magalhães SdS, Miranda DK, Miranda DMd, Malloy-Diniz LF, Romano-Silva MA (2018) The Extreme Climate Event Database (EXCEED): Development of a picture database composed of drought and flood stimuli. PLOS ONE 13(9): e0204093. https://doi.org/10.1371/journal.pone.0204093
- Some evidence that people have affective response to visuals of impacts of extreme events; however, in their sample images (arid land) which brazilians are used to (sensitized) then the response is not as strong </doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Climate_Extremes_Exposure//Reference_Climate_Extremes_Exposure</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="cognitive effect of climate information\non risk perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>relative_perceived_temperature_anomaly_information^(sensitivity_to_climate_information*CRP_climate_attribution_policy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity to climate information">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF TIME&gt;start_year AND switch_environmental_consciousness_policy THEN
normal_sensitivity_to_climate_information*(1 + maximum_effect_of_additional_environmental_consciousness_on_climate_information_sensitivity*additional_environmental_consciousness_policy)
ELSE
normal_sensitivity_to_climate_information</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived climate change risk" access="output" isee:autocreated="true">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>normal_perceived_climate_change_risk*experiential_effect_of_climatic_events_on_risk_perception*cognitive_effect_of_climate_information_on_risk_perception</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity to\nclimatic events exposure">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.347908505629935</eqn>
				</element>
				<element subscript="2">
					<eqn>0.331922627483322</eqn>
				</element>
				<element subscript="3">
					<eqn>0.333230675567874</eqn>
				</element>
				<element subscript="4">
					<eqn>0.342501140129238</eqn>
				</element>
				<element subscript="5">
					<eqn>0.3430016664761</eqn>
				</element>
				<element subscript="6">
					<eqn>0.343407528538181</eqn>
				</element>
				<element subscript="7">
					<eqn>0.339508819781605</eqn>
				</element>
				<element subscript="8">
					<eqn>0.32276673324793</eqn>
				</element>
				<element subscript="9">
					<eqn>0.32948502215024</eqn>
				</element>
				<element subscript="10">
					<eqn>0.335444669704898</eqn>
				</element>
				<element subscript="11">
					<eqn>0.322334550975827</eqn>
				</element>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="experiential effect of climatic events on risk perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(relative_perceived_climate_extremes_exposure +
relative_perceived_SLR_exposure)^(sensitivity_to_climatic_events_exposure*CRP_climate_attribution_policy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Climate indices with record breaking\nexposure per person per year" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Indices/(person*year)</units>
			</aux>
			<aux name="time horizon of reference\ntemperature anomaly">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>time_to_report_and_perceive_climate_information+additional_time_horizon_of_reference_temperature_anomaly</eqn>
				<units>year</units>
			</aux>
			<aux name="time horizon of reference\nclimate extremes exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>time_to_perceive_climate_extremes_exposure[Run]+additional_time_horizon_of_reference_climate_extremes_exposure[Run]</eqn>
				<units>year</units>
			</aux>
			<aux name="switch behavioral impact" access="input">
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="today" access="input">
				<eqn>2025</eqn>
				<units>year</units>
			</aux>
			<aux name="Number of\npeople flooded\nannually in storm surges" access="input">
				<dimensions>
					<dim name="Run"/>
					<dim name="Coastal_Protection_level"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp/year</units>
			</aux>
			<aux name="total people\nflooded annually from\nsea level rise">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SUM(Number_of_people_flooded_annually_in_storm_surges[Run,*])</eqn>
				<units>Mp/year</units>
			</aux>
			<stock name="Perceived SLR\nFlooding Exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_people_flooded_annually_from_sea_level_rise</eqn>
				<inflow>updating_SLR_flooding_exposure</inflow>
				<units>Mp/year</units>
			</stock>
			<flow name="updating SLR flooding exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>IF ( switch_behavioral_impact =0 OR switch_sea_level_rise_climate_risk_perception=0)  AND TIME &gt; today THEN
PREVIOUS(SELF, 0)
ELSE
(total_people_flooded_annually_from_sea_level_rise-Perceived_SLR_Flooding_Exposure)/time_to_perceive_SLR_flooding_exposure</eqn>
				<units>Mp/year/Year</units>
			</flow>
			<stock name="Reference SLR\nFlooding Exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>minimum_reference_for_SLR_flooding_exposure</eqn>
				<inflow>updating_reference_SLR_flooding_exposure</inflow>
				<units>Mp/year</units>
			</stock>
			<flow name="updating reference\nSLR flooding exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(MAX(minimum_reference_for_SLR_flooding_exposure, indicated_reference_SLR_flooding_exposure) - Reference_SLR_Flooding_Exposure)/DT</eqn>
				<units>Mp/year/Year</units>
			</flow>
			<aux name="additional time horizon of reference\nSLR flooding exposure">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>48.0535198427008</eqn>
				<range min="10" max="100"/>
				<units>year</units>
			</aux>
			<aux name="time to perceive\nSLR flooding exposure">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>5.15964579676469</eqn>
				</element>
				<element subscript="2">
					<eqn>4.0817292232146</eqn>
				</element>
				<element subscript="3">
					<eqn>2.50600147374691</eqn>
				</element>
				<element subscript="4">
					<eqn>4.99987793536004</eqn>
				</element>
				<element subscript="5">
					<eqn>1.3495352377336</eqn>
				</element>
				<element subscript="6">
					<eqn>3.46271484209348</eqn>
				</element>
				<element subscript="7">
					<eqn>4.3692855491964</eqn>
				</element>
				<element subscript="8">
					<eqn>5.52428839423779</eqn>
				</element>
				<element subscript="9">
					<eqn>1.55785324667716</eqn>
				</element>
				<element subscript="10">
					<eqn>4.61009944589871</eqn>
				</element>
				<element subscript="11">
					<eqn>2.66921260802666</eqn>
				</element>
				<format precision="0.01"/>
				<range min="1" max="10"/>
				<units>year</units>
			</aux>
			<aux name="time horizon of updating reference\nSLR flooding exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>time_to_perceive_SLR_flooding_exposure[Run]+additional_time_horizon_of_reference_SLR_flooding_exposure[Run]</eqn>
				<units>year</units>
			</aux>
			<aux name="relative perceived\nSLR exposure">
				<doc>

Magalhães SdS, Miranda DK, Miranda DMd, Malloy-Diniz LF, Romano-Silva MA (2018) The Extreme Climate Event Database (EXCEED): Development of a picture database composed of drought and flood stimuli. PLOS ONE 13(9): e0204093. https://doi.org/10.1371/journal.pone.0204093
- Some evidence that people have affective response to visuals of impacts of extreme events; however, in their sample images (arid land) which brazilians are used to (sensitized) then the response is not as strong </doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_SLR_Flooding_Exposure//Reference_SLR_Flooding_Exposure</eqn>
