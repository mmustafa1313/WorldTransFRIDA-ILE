					<eqn>-0.683803833733293</eqn>
				</element>
				<element subscript="11">
					<eqn>-0.845047597168664</eqn>
				</element>
				<range min="-6" max="-0.01"/>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of personal norm\nto social value">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.952926439860167</eqn>
				</element>
				<element subscript="2">
					<eqn>0.970879259322932</eqn>
				</element>
				<element subscript="3">
					<eqn>0.944157731095575</eqn>
				</element>
				<element subscript="4">
					<eqn>0.924125239132006</eqn>
				</element>
				<element subscript="5">
					<eqn>0.941144735660671</eqn>
				</element>
				<element subscript="6">
					<eqn>0.922381083577555</eqn>
