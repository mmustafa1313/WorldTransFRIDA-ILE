				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>100</eqn>
				<units>kCal/Person/Day</units>
			</aux>
			<aux name="minimum required\ndaily caloric intake">
				<doc>${External Parameter}
</doc>
				<eqn>1800</eqn>
				<units>kCal/Person/Day</units>
			</aux>
			<aux name="maximum\nsocioeconomic effect">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+range_of_socioeconomic_effect/2</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="minimum\nsocioeconomic effect">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-(range_of_socioeconomic_effect)/2)*TFD_value_shift_policy_on_minimum_socioeconomic_effect</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="range of\nsocioeconomic effect">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.952005037062242</eqn>
				</element>
