				<units>dmnl</units>
			</aux>
			<aux name="Population 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Mp</units>
			</aux>
			<aux name="animal products production 1" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="effect of climate\nrisk on personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_climate_risk^(sensitivity_of_personal_norm_to_climate_risk*TFD_climate_attribution_policy)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of consumption\nrisk on personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>perceived_consumption_risk^(sensitivity_of_personal_norm_to_consumption_risk*TFD_consumption_risk_policy_on_sensitivity_of_personal_norms)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="effect of social value\non personal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Social_Value^sensitivity_of_personal_norm_to_social_value</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived climate risk" access="input">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Perceived\nSocial Value">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>indicated_social_value</eqn>
				<inflow>change_in_value_perception</inflow>
				<units>dmnl</units>
			</stock>
			<flow name="change in value perception">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_social_value-Perceived_Social_Value)/time_to_adjust_value_perception</eqn>
				<units>dmnl/year</units>
			</flow>
			<aux name="indicated social value">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>normal_perceived_social_value*effect_of_relative_long_term_consumption_on_social_value_perception*TFD_cultural_revaluation_policy</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="time to adjust\nvalue perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>5.44553707805821</eqn>
				</element>
				<element subscript="2">
					<eqn>3.89438380690453</eqn>
				</element>
				<element subscript="3">
					<eqn>5.4080115915394</eqn>
				</element>
				<element subscript="4">
					<eqn>5.08327986741847</eqn>
				</element>
				<element subscript="5">
					<eqn>5.48032227565726</eqn>
				</element>
				<element subscript="6">
					<eqn>5.2292189702167</eqn>
				</element>
				<element subscript="7">
					<eqn>4.38851929359025</eqn>
				</element>
				<element subscript="8">
					<eqn>4.98756442055962</eqn>
				</element>
				<element subscript="9">
					<eqn>4.7923450399747</eqn>
				</element>
				<element subscript="10">
					<eqn>5.50926751326335</eqn>
				</element>
				<element subscript="11">
					<eqn>3.79342737030841</eqn>
				</element>
				<range min="3" max="50"/>
				<units>years</units>
			</aux>
			<aux name="UNIT c$ per billion c$">
				<doc>${Unit}
</doc>
				<eqn>1000000000</eqn>
				<units>c$/bc$</units>
			</aux>
			<aux name="sensitivity of demand\nto scarcity">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.270351557464571</eqn>
				</element>
