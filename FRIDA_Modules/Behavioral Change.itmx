				</element>
				<range min="0.1" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="expectation\ntime horizon">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="maximum useful\nfertilizer per year">
				<doc>${External Parameter}
Planetary health diet from EAT Lancet https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(18)31788-4/fulltext#seccestitle80
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Cropland*maximum_useful_fertilizer_per_Mha</eqn>
				<units>MtN/year</units>
			</aux>
			<aux name="consumption relative\nto healthy reference">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_consumption/maximum_useful_fertilizer_per_year</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived\nconsumption risk">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(consumption_relative_to_healthy_reference,  time_to_observe_consequences, consumption_relative_to_healthy_reference)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="time to observe\nconsequences">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.53058837686596</eqn>
				</element>
				<element subscript="2">
					<eqn>1.65071569876575</eqn>
				</element>
