			<aux name="maximum\nsocioeconomic effect">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1+range_of_socioeconomic_effect/2</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="minimum\nsocioeconomic effect">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
