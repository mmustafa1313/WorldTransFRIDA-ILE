				<alias font_style="italic" font_weight="bold" label_side="top" uid="45" x="478.571" y="720.286" width="18" height="18">
					<of>today</of>
				</alias>
			</view>
		</views>
	</model>
	<model name="Fertilizer_Demand">
		<variables>
			<flow name="change in desired yearly\ndemand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_desired_yearly_demand-Desired_Yearly_Demand)/time_to_adjust_demand_pattern</eqn>
				<units>MtN/year/Year</units>
			</flow>
			<stock name="Desired Yearly\nDemand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>initial_fertilizer_demand_in_1980</eqn>
				<inflow>change_in_desired_yearly_demand</inflow>
				<units>MtN/year</units>
			</stock>
			<aux name="time to adjust\ndemand pattern">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.00878461637284</eqn>
				</element>
