	<model name="Behavioral_Change">
		<variables>
			<module name="Climate Risk\nPerception" isee:label="">
				<format scale_by="auto"/>
				<connect to="Animal_Products_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect2 to="Animal_Products_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect to="Total_Food_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect2 to="Total_Food_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect to="Transportation_Energy_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect2 to="Transportation_Energy_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect to="Animal_Products_Demand.start_year" from="Climate_Risk_Perception.start_year"/>
				<connect2 to="Animal_Products_Demand.start_year" from="Climate_Risk_Perception.start_year"/>
				<connect to="Climate_Risk_Perception.additional_environmental_consciousness_policy" from="Behavioral_Choices.additional_environmental_consciousness_policy"/>
				<connect2 to="Climate_Risk_Perception.additional_environmental_consciousness_policy" from="Behavioral_Choices.additional_environmental_consciousness_policy"/>
				<connect to="Climate_Risk_Perception.Climate_indices_with_record_breaking_exposure_per_person_per_year" from="Energy_Balance_Model.Climate_indices_with_record_breaking_exposure_per_person_per_year"/>
				<connect2 to="Climate_Risk_Perception.Climate_indices_with_record_breaking_exposure_per_person_per_year" from="Energy_Balance_Model.Climate_indices_with_record_breaking_exposure_per_person_per_year"/>
				<connect to="Climate_Risk_Perception.CRP_climate_attribution_policy" from="Behavior_Change_Policy.CRP_climate_attribution_policy"/>
				<connect2 to="Climate_Risk_Perception.CRP_climate_attribution_policy" from="Behavior_Change_Policy.CRP_climate_attribution_policy"/>
				<connect to="Climate_Risk_Perception.Number_of_people_flooded_annually_in_storm_surges" from="Coastal_population.Number_of_people_flooded_annually_in_storm_surges"/>
				<connect2 to="Climate_Risk_Perception.Number_of_people_flooded_annually_in_storm_surges" from="Coastal_population.Number_of_people_flooded_annually_in_storm_surges"/>
				<connect to="Climate_Risk_Perception.start_year" from="Behavioral_Choices.start_year"/>
				<connect2 to="Climate_Risk_Perception.start_year" from="Behavioral_Choices.start_year"/>
				<connect to="Climate_Risk_Perception.Surface_Temperature_Anomaly" from="Energy_Balance_Model.Surface_Temperature_Anomaly"/>
