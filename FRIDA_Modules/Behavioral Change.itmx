	</model>
	<model name="Total_Food_Demand">
		<variables>
			<flow name="change in desired demand per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_average_desired_demand_per_capita-Desired_Average_Daily_Demand_Per_Capita)/time_to_adjust_consumption_pattern</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<stock name="Desired Average Daily\nDemand Per Capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita_in_1980</eqn>
				<inflow>change_in_desired_demand_per_capita</inflow>
				<units>kcal/person/day</units>
			</stock>
			<aux name="UNIT cal per pcal">
				<doc>${Unit}
</doc>
				<eqn>1000000000000</eqn>
				<units>KCal/PCal</units>
			</aux>
			<aux name="average yearly\ndemand per capita" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita*UNIT_days_per_year*UNIT_p_per_Mp/UNIT_cal_per_pcal</eqn>
				<units>PCal/Mp/Year</units>
			</aux>
			<aux name="UNIT days per year">
				<doc>${Unit}
</doc>
				<eqn>365</eqn>
				<units>days/year</units>
			</aux>
			<aux name="UNIT p per Mp">
				<doc>${Unit}
</doc>
				<eqn>1000000</eqn>
				<units>person/Mp</units>
			</aux>
			<aux name="time to adjust\nconsumption pattern">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.30266345550492</eqn>
				</element>
				<element subscript="2">
					<eqn>1.41407379213641</eqn>
				</element>
				<element subscript="3">
					<eqn>1.34799980570812</eqn>
				</element>
				<element subscript="4">
					<eqn>1.54698417808951</eqn>
				</element>
				<element subscript="5">
					<eqn>1.52111386798256</eqn>
				</element>
				<element subscript="6">
					<eqn>1.46640255959619</eqn>
				</element>
				<element subscript="7">
					<eqn>1.5064319700669</eqn>
				</element>
				<element subscript="8">
					<eqn>1.31675720617469</eqn>
				</element>
				<element subscript="9">
					<eqn>1.47456310263277</eqn>
				</element>
				<element subscript="10">
					<eqn>1.28027029369884</eqn>
				</element>
				<element subscript="11">
					<eqn>1.3700880022756</eqn>
				</element>
				<range min="1" max="10"/>
				<units>years</units>
			</aux>
			<aux name="total yearly\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN(total_yearly_demand, total_food_supply)</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="average daily\nconsumption per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_consumption/Population_1/UNIT_days_per_year/UNIT_p_per_Mp*UNIT_cal_per_pcal</eqn>
				<units>kcal/person/day</units>
			</aux>
			<stock name="Perceived Average\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_consumption_per_capita</eqn>
				<inflow>updating_perceived_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating perceived\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(average_daily_consumption_per_capita-Perceived_Average_Consumption)/time_to_perceive_average_consumption</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time to perceive\naverage consumption">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.12624984558252</eqn>
				</element>
				<element subscript="2">
					<eqn>1.273039470181</eqn>
				</element>
				<element subscript="3">
					<eqn>1.22907836062695</eqn>
				</element>
				<element subscript="4">
					<eqn>1.00053842139168</eqn>
				</element>
				<element subscript="5">
					<eqn>1.55083001060525</eqn>
				</element>
				<element subscript="6">
					<eqn>1.51095192993811</eqn>
				</element>
				<element subscript="7">
					<eqn>1.19419563398263</eqn>
				</element>
				<element subscript="8">
					<eqn>1.62897589314774</eqn>
				</element>
				<element subscript="9">
					<eqn>1.01994651840845</eqn>
				</element>
				<element subscript="10">
					<eqn>1.30508551375249</eqn>
				</element>
				<element subscript="11">
					<eqn>1.20506875486461</eqn>
				</element>
				<range min="1" max="5"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nShort Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_short_term_reference_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating short term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/time_horizon_for_short_term_perception</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nshort term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.05596074020436</eqn>
				</element>
				<element subscript="2">
					<eqn>2.77442434119157</eqn>
				</element>
				<element subscript="3">
					<eqn>1.23903578419175</eqn>
				</element>
				<element subscript="4">
					<eqn>1.40865345757504</eqn>
				</element>
				<element subscript="5">
					<eqn>2.48964263090785</eqn>
				</element>
				<element subscript="6">
					<eqn>2.60882561106561</eqn>
				</element>
				<element subscript="7">
					<eqn>2.26920968255118</eqn>
				</element>
				<element subscript="8">
					<eqn>2.3906152601164</eqn>
				</element>
				<element subscript="9">
					<eqn>2.8188306195311</eqn>
				</element>
				<element subscript="10">
					<eqn>2.2723608994234</eqn>
				</element>
				<element subscript="11">
					<eqn>2.87608533767817</eqn>
				</element>
				<range min="1" max="20"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nLong Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_long_term_reference_consumption</inflow>
				<units>kcal/person/day</units>
			</stock>
			<flow name="updating long term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Long_Term_Consumption)/time_horizon_for_long_term_perception</eqn>
				<units>kcal/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nlong term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>43.0476186600816</eqn>
				</element>
				<element subscript="2">
					<eqn>57.4203145388836</eqn>
				</element>
				<element subscript="3">
					<eqn>64.7753352526499</eqn>
				</element>
				<element subscript="4">
					<eqn>53.811111723666</eqn>
				</element>
				<element subscript="5">
					<eqn>43.8083723280883</eqn>
				</element>
				<element subscript="6">
					<eqn>63.6340814518281</eqn>
				</element>
				<element subscript="7">
					<eqn>57.6217847971532</eqn>
				</element>
				<element subscript="8">
					<eqn>54.8902229234058</eqn>
				</element>
				<element subscript="9">
					<eqn>53.2441837876052</eqn>
				</element>
				<element subscript="10">
					<eqn>64.4088911843653</eqn>
				</element>
				<element subscript="11">
					<eqn>54.8601380133582</eqn>
				</element>
				<range min="20" max="100"/>
				<units>year</units>
			</aux>
			<aux name="indicated short term\ntrend">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/Reference_Short_Term_Consumption/time_horizon_for_short_term_perception</eqn>
				<units>dmnl/year</units>
			</aux>
			<aux name="desired demand\nfrom descriptive norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Average_Daily_Demand_Per_Capita*(1+ indicated_short_term_trend*expectation_time_horizon)</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="total food supply">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>animal_products_production_1+crop_supply_for_vegetal_products_1</eqn>
				<units>PCal/Year</units>
			</aux>
			<aux name="food scarcity">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_food_supply/total_yearly_demand</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="time to adjust desired\ndemand from accessibility">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
				<element subscript="6">
					<eqn>1</eqn>
				</element>
				<element subscript="7">
					<eqn>1</eqn>
				</element>
				<element subscript="8">
					<eqn>1</eqn>
				</element>
				<element subscript="9">
					<eqn>1</eqn>
				</element>
				<element subscript="10">
					<eqn>1</eqn>
				</element>
				<element subscript="11">
					<eqn>1</eqn>
				</element>
				<range min="1" max="5"/>
				<units>years</units>
			</aux>
			<aux name="perceived consumption\nrelative to long term average">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption/Reference_Long_Term_Consumption</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="desired demand\nfrom personal norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MAXSOFT(Desired_Average_Daily_Demand_Per_Capita*effect_of_climate_risk_on_personal_norm*effect_of_consumption_risk_on_personal_norm*effect_of_social_value_on_personal_norm,  minimum_required_daily_caloric_intake,  tolerance_of_minimum_required_caloric_intake)</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="sensitivity of personal norm\nto climate risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.266209617745855</eqn>
				</element>
				<element subscript="2">
					<eqn>-0.262804243381746</eqn>
				</element>
				<element subscript="3">
					<eqn>-0.271501453992154</eqn>
				</element>
				<element subscript="4">
					<eqn>-0.267161745716083</eqn>
				</element>
				<element subscript="5">
					<eqn>-0.272324793819351</eqn>
				</element>
				<element subscript="6">
					<eqn>-0.273029409356143</eqn>
				</element>
				<element subscript="7">
					<eqn>-0.259730101036692</eqn>
				</element>
				<element subscript="8">
					<eqn>-0.2701616489164</eqn>
				</element>
				<element subscript="9">
					<eqn>-0.263822151026388</eqn>
				</element>
				<element subscript="10">
					<eqn>-0.270097473624289</eqn>
				</element>
				<element subscript="11">
					<eqn>-0.276801166297031</eqn>
				</element>
				<range min="-1" max="-0.01"/>
				<units>dmnl</units>
			</aux>
			<aux name="sensitivity of personal norm\nto social value">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.957389271214011</eqn>
				</element>
				<element subscript="2">
					<eqn>0.944650806816065</eqn>
				</element>
				<element subscript="3">
					<eqn>0.92229185658309</eqn>
				</element>
				<element subscript="4">
					<eqn>0.890521382666796</eqn>
				</element>
				<element subscript="5">
					<eqn>0.91337970308122</eqn>
				</element>
				<element subscript="6">
					<eqn>0.988458816967876</eqn>
				</element>
				<element subscript="7">
					<eqn>0.907627485109737</eqn>
				</element>
				<element subscript="8">
					<eqn>0.972414801681855</eqn>
				</element>
				<element subscript="9">
					<eqn>0.961273170104653</eqn>
				</element>
				<element subscript="10">
					<eqn>0.989901807574566</eqn>
				</element>
				<element subscript="11">
					<eqn>0.984829127938959</eqn>
				</element>
				<range min="0.1" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="expectation\ntime horizon">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="healthy reference\ndaily consumption\nper capita">
				<doc>${External Parameter}
Planetary health diet from EAT Lancet https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(18)31788-4/fulltext#seccestitle80
</doc>
				<eqn>2500</eqn>
				<units>kcal/person/day</units>
			</aux>
			<aux name="consumption relative\nto healthy reference">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_consumption_per_capita/healthy_reference_daily_consumption_per_capita</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="perceived\nconsumption risk">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(consumption_relative_to_healthy_reference,  time_to_observe_consequences, consumption_relative_to_healthy_reference)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="time to observe\nconsequences">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>6.89633721029332</eqn>
				</element>
				<element subscript="2">
					<eqn>7.54409886248451</eqn>
				</element>
				<element subscript="3">
					<eqn>7.12626543365373</eqn>
				</element>
				<element subscript="4">
					<eqn>8.10097575202984</eqn>
				</element>
				<element subscript="5">
					<eqn>7.14360192582511</eqn>
				</element>
				<element subscript="6">
					<eqn>7.94914962427649</eqn>
				</element>
				<element subscript="7">
					<eqn>7.22413272816955</eqn>
				</element>
				<element subscript="8">
					<eqn>7.62124225806367</eqn>
				</element>
				<element subscript="9">
					<eqn>7.45179202813058</eqn>
				</element>
				<element subscript="10">
					<eqn>7.901054839543</eqn>
				</element>
				<element subscript="11">
					<eqn>7.26764173110286</eqn>
				</element>
				<range min="5" max="30"/>
				<units>years</units>
			</aux>
			<aux name="sensitivity of personal norm\nto consumption risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.901527483681586</eqn>
				</element>
