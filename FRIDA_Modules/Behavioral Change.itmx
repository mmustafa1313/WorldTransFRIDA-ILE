				</element>
				<range min="1" max="5"/>
				<units>years</units>
			</aux>
			<aux name="perceived consumption\nrelative to long term average">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Yearly_Consumption/Reference_Long_Term_Consumption</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="desired demand\nfrom personal norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Yearly_Demand*effect_of_consumption_risk_on_personal_norm*effect_of_social_value_on_personal_norm</eqn>
				<units>MtN/year</units>
			</aux>
			<aux name="sensitivity of personal norm\nto social value">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
