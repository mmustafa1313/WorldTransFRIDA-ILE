				<units>dmnl</units>
			</aux>
			<aux name="expectation\ntime horizon">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>year</units>
			</aux>
			<aux name="perceived\nconsumption risk">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>SMTH1(Health_risk_from_pm25_emissions_exposure,  time_to_observe_consequences, Health_risk_from_pm25_emissions_exposure)</eqn>
				<isee:delay_aux/>
				<units>dmnl</units>
			</aux>
			<aux name="time to observe\nconsequences">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>7.43228905745963</eqn>
				<range min="5" max="30"/>
				<units>years</units>
			</aux>
			<aux name="sensitivity of personal norm\nto consumption risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
