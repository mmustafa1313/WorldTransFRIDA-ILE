				<units>Dimensionless</units>
			</aux>
			<aux name="effect of natural gas scarcity on accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>1-Ratio_of_natural_gas_needed_for_fertilizer_over_natural_gas_production</eqn>
				<units>Dimensionless</units>
