			</aux>
			<stock name="Reference\nLong Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Yearly_Consumption</eqn>
				<inflow>updating_long_term_reference_consumption</inflow>
				<units>MtN/year</units>
			</stock>
			<flow name="updating long term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Yearly_Consumption-Reference_Long_Term_Consumption)/time_horizon_for_long_term_perception</eqn>
				<units>MtN/year/Year</units>
			</flow>
			<aux name="time horizon for\nlong term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>20.0721663881299</eqn>
