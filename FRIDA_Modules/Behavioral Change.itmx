			</aux>
			<aux name="indicated updating\nReference SLR flooding exposure">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_SLR_Flooding_Exposure-Reference_SLR_Flooding_Exposure)/time_horizon_of_updating_reference_SLR_flooding_exposure</eqn>
				<units>Mp/year/Year</units>
			</aux>
			<aux name="minimum reference for\nSLR flooding exposure">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>11.1249174904855</eqn>
				</element>
