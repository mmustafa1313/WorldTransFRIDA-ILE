			<aux name="effect of\nenergy scarcity\non demand">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Energy_Balance^sensitivity_of_demand_to_scarcity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="normal perceived\nsocial value">
				<doc>${Assumption}
</doc>
				<eqn>1</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="indicated\naverage desired demand per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>MIN((weight_of_personal_norm*desired_demand_from_personal_norm + desired_demand_from_descriptive_norm*weight_of_descriptive_norm + weight_of_accessibility*Desired_Demand_from_Accessibility), Desired_Demand_from_Accessibility)</eqn>
				<units>MWh/p/day</units>
			</aux>
			<aux name="indicated demand\nfrom accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita_in_1980*effect_of_energy_scarcity_on_demand*effect_of_GDP_per_capita_on_demand</eqn>
				<units>MWh/person/day</units>
			</aux>
			<flow name="change in desired\ndemand from accessibility">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_demand_from_accessibility-Desired_Demand_from_Accessibility)/time_to_adjust_desired_demand_from_accessibility</eqn>
				<units>MWh/person/day/Year</units>
			</flow>
			<aux name="weight of\naccessibility">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>reference_weight_of_accessibility*socioeconomic_effect_on_weight_of_accessibility</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\npersonal norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*relative_weight_of_personal_norm</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="weight of\ndescriptive norm">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(1-weight_of_accessibility)*(1-relative_weight_of_personal_norm)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="relative weight\nof personal norm">
				<doc>${Assumption}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="total yearly demand">
				<doc>https://www.iea.org/world/energy-mix</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_yearly_demand_per_capita*Population_1</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="average daily\ndemand per capita" access="output" isee:autocreated="true">
				<doc>${Calibrated Output,Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
