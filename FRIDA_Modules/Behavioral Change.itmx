				<connect2 to="Animal_Products_Demand.value_shift_policy_on_minimum_socioeconomic_effect" from="Behavior_Change_Policy.APD_value_shift_policy"/>
			</module>
			<module name="Total Food\nDemand" isee:label="">
				<format scale_by="auto"/>
				<connect to="Food_Demand.Average_Daily_Demand_Per_Capita" from="Total_Food_Demand.average_daily_demand_per_capita"/>
				<connect2 to="Food_Demand.Average_Daily_Demand_Per_Capita" from="Total_Food_Demand.average_daily_demand_per_capita"/>
				<connect to="Total_Food_Demand.animal_products_production_1" from="Animal_Products.animal_products_production"/>
				<connect2 to="Total_Food_Demand.animal_products_production_1" from="Animal_Products.animal_products_production"/>
				<connect to="Total_Food_Demand.crop_supply_for_vegetal_products_1" from="Food_Demand.crop_supply_for_vegetal_products"/>
				<connect2 to="Total_Food_Demand.crop_supply_for_vegetal_products_1" from="Food_Demand.crop_supply_for_vegetal_products"/>
				<connect to="Total_Food_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect2 to="Total_Food_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
				<connect to="Total_Food_Demand.Population_1" from="Demographics.Population"/>
				<connect2 to="Total_Food_Demand.Population_1" from="Demographics.Population"/>
				<connect to="Total_Food_Demand.real_GDP_per_person_1" from="Food_Demand.real_GDP_per_person"/>
				<connect2 to="Total_Food_Demand.real_GDP_per_person_1" from="Food_Demand.real_GDP_per_person"/>
				<connect to="Total_Food_Demand.TFD_climate_attribution_policy" from="Behavior_Change_Policy.TFD_climate_attribution_policy"/>
				<connect2 to="Total_Food_Demand.TFD_climate_attribution_policy" from="Behavior_Change_Policy.TFD_climate_attribution_policy"/>
				<connect to="Total_Food_Demand.TFD_consumption_risk_policy_on_sensitivity_of_personal_norms" from="Behavior_Change_Policy.TFD_consumption_risk_policy"/>
				<connect2 to="Total_Food_Demand.TFD_consumption_risk_policy_on_sensitivity_of_personal_norms" from="Behavior_Change_Policy.TFD_consumption_risk_policy"/>
				<connect to="Total_Food_Demand.TFD_cultural_revaluation_policy" from="Behavior_Change_Policy.TFD_cultural_revaluation_policy"/>
				<connect2 to="Total_Food_Demand.TFD_cultural_revaluation_policy" from="Behavior_Change_Policy.TFD_cultural_revaluation_policy"/>
