				<connect to="Animal_Products_Demand.APD_cultural_revaluation_policy" from="Behavior_Change_Policy.APD_cultural_revaluation_policy"/>
				<connect2 to="Animal_Products_Demand.APD_cultural_revaluation_policy" from="Behavior_Change_Policy.APD_cultural_revaluation_policy"/>
				<connect to="Animal_Products_Demand.Average_Daily_Demand_Per_Capita_1" from="Food_Demand.direct_food_demand_per_person_per_day"/>
				<connect2 to="Animal_Products_Demand.Average_Daily_Demand_Per_Capita_1" from="Food_Demand.direct_food_demand_per_person_per_day"/>
				<connect to="Animal_Products_Demand.crop_balance_1" from="Crop.crop_balance"/>
				<connect2 to="Animal_Products_Demand.crop_balance_1" from="Crop.crop_balance"/>
				<connect to="Animal_Products_Demand.perceived_climate_risk" from="Climate_Risk_Perception.perceived_climate_change_risk"/>
