			<module name="Behavior Change\nPolicy" isee:label="" url="/Users/bschoenberg/Library/Application Support/isee systems/Stella Architect/com.iseesystems.StellaArchitect Temp/FRIDA_Modules/Behavior Change Policy.itmx">
