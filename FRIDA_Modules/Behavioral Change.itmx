	</model>
	<model name="Transportation_Energy_Demand">
		<variables>
			<flow name="change in desired demand per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(indicated_average_desired_demand_per_capita-Desired_Average_Daily_Demand_Per_Capita)/time_to_adjust_consumption_pattern</eqn>
				<units>MWh/person/day/Year</units>
			</flow>
			<stock name="Desired Average Daily\nDemand Per Capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita_in_1980</eqn>
				<inflow>change_in_desired_demand_per_capita</inflow>
				<units>MWh/person/day</units>
			</stock>
			<aux name="average yearly\ndemand per capita" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_demand_per_capita*UNIT_days_per_year*UNIT_p_per_Mp</eqn>
				<units>MWh/Mp/Year</units>
			</aux>
			<aux name="UNIT days per year">
				<doc>${Unit}
</doc>
				<eqn>365</eqn>
				<units>days/year</units>
			</aux>
			<aux name="UNIT p per Mp">
				<doc>${Unit}
</doc>
				<eqn>1000000</eqn>
				<units>person/Mp</units>
			</aux>
			<aux name="time to adjust\nconsumption pattern">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
				<element subscript="6">
					<eqn>1</eqn>
				</element>
				<element subscript="7">
					<eqn>1</eqn>
				</element>
				<element subscript="8">
					<eqn>1</eqn>
				</element>
				<element subscript="9">
					<eqn>1</eqn>
				</element>
				<element subscript="10">
					<eqn>1</eqn>
				</element>
				<element subscript="11">
					<eqn>1</eqn>
				</element>
				<range min="1" max="10"/>
				<units>years</units>
			</aux>
			<aux name="total yearly\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_demand</eqn>
				<units>MWh/year</units>
			</aux>
			<aux name="average daily\nconsumption per capita">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>total_yearly_consumption/Population_1/UNIT_days_per_year/UNIT_p_per_Mp</eqn>
				<units>MWh/person/day</units>
			</aux>
			<stock name="Perceived Average\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>average_daily_consumption_per_capita</eqn>
				<inflow>updating_perceived_consumption</inflow>
				<units>MWh/person/day</units>
			</stock>
			<flow name="updating perceived\nconsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(average_daily_consumption_per_capita-Perceived_Average_Consumption)/time_to_perceive_average_consumption</eqn>
				<units>MWh/person/day/Year</units>
			</flow>
			<aux name="time to perceive\naverage consumption">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1.01042576207837</eqn>
				</element>
				<element subscript="2">
					<eqn>1.0101947814135</eqn>
				</element>
				<element subscript="3">
					<eqn>1.00245956515388</eqn>
				</element>
				<element subscript="4">
					<eqn>1.00484795794883</eqn>
				</element>
				<element subscript="5">
					<eqn>1.00124263314175</eqn>
				</element>
				<element subscript="6">
					<eqn>1.00502407658702</eqn>
				</element>
				<element subscript="7">
					<eqn>1.00998233521711</eqn>
				</element>
				<element subscript="8">
					<eqn>1.00033576219329</eqn>
				</element>
				<element subscript="9">
					<eqn>1.00897076511564</eqn>
				</element>
				<element subscript="10">
					<eqn>1.0009492942874</eqn>
				</element>
				<element subscript="11">
					<eqn>1.00617766190469</eqn>
				</element>
				<range min="1" max="5"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nShort Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_short_term_reference_consumption</inflow>
				<units>MWh/person/day</units>
			</stock>
			<flow name="updating short term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/time_horizon_for_short_term_perception</eqn>
				<units>MWh/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nshort term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>14.7607065567888</eqn>
				</element>
				<element subscript="2">
					<eqn>11.9926614107119</eqn>
				</element>
				<element subscript="3">
					<eqn>14.3084412569653</eqn>
				</element>
				<element subscript="4">
					<eqn>10.5427330008622</eqn>
				</element>
				<element subscript="5">
					<eqn>8.01702685801136</eqn>
				</element>
				<element subscript="6">
					<eqn>8.15564520002606</eqn>
				</element>
				<element subscript="7">
					<eqn>12.0362024799496</eqn>
				</element>
				<element subscript="8">
					<eqn>3.45947617897317</eqn>
				</element>
				<element subscript="9">
					<eqn>4.50867549253882</eqn>
				</element>
				<element subscript="10">
					<eqn>2.62193183969185</eqn>
				</element>
				<element subscript="11">
					<eqn>9.66348431238547</eqn>
				</element>
				<range min="1" max="20"/>
				<units>year</units>
			</aux>
			<stock name="Reference\nLong Term\nConsumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption</eqn>
				<inflow>updating_long_term_reference_consumption</inflow>
				<units>MWh/person/day</units>
			</stock>
			<flow name="updating long term\nreference consumption">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Long_Term_Consumption)/time_horizon_for_long_term_perception</eqn>
				<units>MWh/person/day/Year</units>
			</flow>
			<aux name="time horizon for\nlong term perception">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>96.5111497546481</eqn>
				</element>
				<element subscript="2">
					<eqn>95.1554250338691</eqn>
				</element>
				<element subscript="3">
					<eqn>98.9613524883219</eqn>
				</element>
				<element subscript="4">
					<eqn>94.7957520439594</eqn>
				</element>
				<element subscript="5">
					<eqn>92.8376251123436</eqn>
				</element>
				<element subscript="6">
					<eqn>98.9331035893</eqn>
				</element>
				<element subscript="7">
					<eqn>98.2729802029026</eqn>
				</element>
				<element subscript="8">
					<eqn>98.74303520966</eqn>
				</element>
				<element subscript="9">
					<eqn>93.2740372373917</eqn>
				</element>
				<element subscript="10">
					<eqn>99.8262803926286</eqn>
				</element>
				<element subscript="11">
					<eqn>93.2217100445184</eqn>
				</element>
				<range min="20" max="100"/>
				<units>year</units>
			</aux>
			<aux name="indicated short term\ntrend">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>(Perceived_Average_Consumption-Reference_Short_Term_Consumption)/Reference_Short_Term_Consumption/time_horizon_for_short_term_perception</eqn>
				<units>dmnl/year</units>
			</aux>
			<aux name="desired demand\nfrom descriptive norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Average_Daily_Demand_Per_Capita*(1+ indicated_short_term_trend*expectation_time_horizon)</eqn>
				<units>MWh/person/day</units>
			</aux>
			<aux name="time to adjust desired\ndemand from accessibility">
				<doc>${Internal Calibration Parameter}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>1</eqn>
				</element>
				<element subscript="2">
					<eqn>1</eqn>
				</element>
				<element subscript="3">
					<eqn>1</eqn>
				</element>
				<element subscript="4">
					<eqn>1</eqn>
				</element>
				<element subscript="5">
					<eqn>1</eqn>
				</element>
				<element subscript="6">
					<eqn>1</eqn>
				</element>
				<element subscript="7">
					<eqn>1</eqn>
				</element>
				<element subscript="8">
					<eqn>1</eqn>
				</element>
				<element subscript="9">
					<eqn>1</eqn>
				</element>
				<element subscript="10">
					<eqn>1</eqn>
				</element>
				<element subscript="11">
					<eqn>1</eqn>
				</element>
				<range min="1" max="5"/>
				<units>years</units>
			</aux>
			<aux name="perceived consumption\nrelative to long term average">
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Perceived_Average_Consumption/Reference_Long_Term_Consumption</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="desired demand\nfrom personal norm">
				<doc>${Explanatory Variable}
</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<eqn>Desired_Average_Daily_Demand_Per_Capita*effect_of_climate_risk_on_personal_norm*effect_of_social_value_on_personal_norm*effect_of_consumption_risk_on_personal_norm</eqn>
				<units>MWh/person/day</units>
			</aux>
			<aux name="sensitivity of personal norm\nto climate risk">
				<doc>${Internal Calibration Parameter}
Calibration Parameter: fertilizer use &amp; crop production</doc>
				<dimensions>
					<dim name="Run"/>
				</dimensions>
				<element subscript="1">
					<eqn>-0.779908953359848</eqn>
				</element>
				<element subscript="2">
					<eqn>-0.810127799034774</eqn>
				</element>
				<element subscript="3">
					<eqn>-0.693012448906982</eqn>
				</element>
				<element subscript="4">
					<eqn>-0.833825851073836</eqn>
				</element>
				<element subscript="5">
					<eqn>-0.860166137446893</eqn>
				</element>
				<element subscript="6">
					<eqn>-0.695339219790472</eqn>
				</element>
				<element subscript="7">
					<eqn>-0.739407457988995</eqn>
				</element>
				<element subscript="8">
					<eqn>-0.86473762224698</eqn>
				</element>
